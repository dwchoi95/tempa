rule cm_to_feet_inches_from_direct_rounded_inches
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $b = $n % 36
    $c = $b // 3
    if $b % 3 == 2:
        $c += 1
    print($a, $c)
where: True
rewrite:
    $n = int(input())
    $inc = $n // 3
    if $n % 3 == 2:
        $inc += 1
    $a = $inc // 12
    $b = $inc % 12
    print($a, $b)

rule add_one_before_dividing_by_36
symptoms: wrong
match: $x = (int(input()) + 2) // 3
where: True
rewrite: $x = (int(input()) + 1) // 3

rule shift_rounding_from_inches_to_feet_after_add_one
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $n %= 36
    $b = ($n + 1) // 3
    print($a, $b)
where: True
rewrite:
    $n = int(input())
    $n += 1
    $a = $n // 36
    $b = ($n % 36) // 3
    print($a, $b)

rule round_inches_before_feet_in_float_solution
symptoms: wrong
match:
    $n = float(input())
    $feet = int($n / 36 + 0.5)
    $r = $n - 36 * $feet
    $inch = int($r / 3 + 0.5)
    print($feet, $SEP, $inch)
where: True
rewrite:
    $n = float(input())
    $inch = int($n / 3 + 0.5)
    $feet = int($inch / 12)
    $r = $inch - 12 * $feet
    print($feet, $SEP, $r)

rule int_cast_printed_feet_and_inches
symptoms: wrong
match:
    print(str($a // 12) + ' ' + str($a % 12))
where: True
rewrite:
    print(str(int($a // 12)) + ' ' + str(int($a % 12)))

rule convert_rounding_to_feet_then_remainder
symptoms: wrong
match:
    $n = int(input())
    $x = round($n / 3)
    $y = $x // 12
    $z = $x - 12 * $y
    print($y, $z)
where: True
rewrite:
    $n = int(input())
    $x = round($n / 3)
    $y = $x // 12
    $z = $x % 12
    print($y, $z)

rule fix_feet_inches_when_rounding_half_up
symptoms: wrong
match:
    $n = int(input())
    print($n // 36 + ($n % 36) / 3)
where: True
rewrite:
    $n = int(input()) + 1
    print($n // 36, $n % 36 // 3)

rule compute_inches_then_split_into_feet
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $n %= 36
    $b = $n // 3
    if $n % 3 == 2:
        $b += 1
    print($a, $b)
where: True
rewrite:
    $n = int(input())
    $a = $n // 3
    $b = $n % 3
    if $b == 2:
        $a += 1
    $p = $a // 12
    $q = $a % 12
    print($p, $q)

rule correct_wrong_modulus_26_to_36
symptoms: wrong
match:
    $cms = int(input())
    $inch = $cms // 36
    $cms = $cms % 26
    print($inch, $cms // 3)
where: True
rewrite:
    $cms = int(input())
    $inch = $cms // 36
    $cms = $cms % 36
    print($inch, $cms // 3)

rule round_remainder_by_ceiling_in_inches
symptoms: wrong
match:
    $length = int(input())
    feet, rest = divmod($length, 12 * 3)
    inches, rest = divmod(rest, 3)
    print(feet, inches + 1 if rest > 1 else inches)
where: True
rewrite:
    $length = int(input())
    inc = $length // 3
    rem = $length % 3
    inc += 1 if rem == 2 else 0
    ft = inc // 12
    inc = inc % 12
    print(ft, inc)

rule fix_printing_single_count_as_both_units
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $b = round(($n % 36) / 3)
    print(str($a) + ' ' + str($b))
where: True
rewrite:
    $n = int(input())
    $inches = $n // 3
    if $n % 3 >= 2:
        $inches += 1
    print($inches // 12, " ", $inches % 12)

rule ceil_rounding_with_integer_conversion
symptoms: wrong
match:
    $a = int(input())
    $a /= 3
    if $a % 1 < 0.5:
        $a //= 1
    else:
        $a = $a // 1 + 1
    print(str($a // 12) + ' ' + str($a % 12))
where: True
rewrite:
    $a = int(input())
    $a /= 3
    if $a % 1 < 0.5:
        $a //= 1
    else:
        $a = $a // 1 + 1
    print(str(int($a // 12)) + ' ' + str(int($a % 12)))

rule fix_round_function_guard
symptoms: wrong
match:
    def $f($*xs):
        $body:Stmts
where: some($body, "if roundI==1:\n    return 0") or some($body, "if inch<=1:\n    return 0")
rewrite:
    def $f($*xs):
        $body:Stmts

rule fix_rounding_from_cm_to_inches_with_carry
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $b = 0
    if $n % 36 >= 18:
        $a += 1
        $n = 0
    else:
        $b = ($n % 36) // 3
        if ($n % 36) % 3 >= 2:
            $b += 1
    print($a, $b)
where: True
rewrite:
    $n = int(input())
    if $n % 3 == 0:
        $inc = $n // 3
    elif $n % 3 == 1:
        $inc = $n // 3
    else:
        $inc = $n // 3 + 1
    $feet = $inc // 12
    $inc = $inc % 12
    print($feet, $inc)

rule fix_bad_thresholds_for_remainder_rounding
symptoms: wrong
match:
    $n = int(input())
    $add = ($n % 36) % 3
    if $add >= 2:
        $add = 1
    else:
        $add = 0
    print($n // 36, ($n % 36) // 3 + $add)
where: True
rewrite:
    $n = int(input())
    $add = $n % 3
    if $add >= 2:
        $add = 1
    else:
        $add = 0
    $inc = $n // 3 + $add
    print($inc // 12, $inc % 12)

rule fix_just_add_one_then_split
symptoms: wrong
match:
    $n = int(input())
    $e = ($n + 1) // 36
    $n -= 36 * $e
    print($e, ($n + 1) // 3)
where: True
rewrite:
    $n = int(input())
    $e = $n // 36
    $n %= 36
    print($e, ($n + 1) // 3)