rewrite:
    food = sorted(food.values(), reverse=True)

rule simplify_greedy_capacity_loop
symptoms: wrong
match:
    b=[0]*len(food)

    b[0]=n
    prev_days=food[0]//b[0]
    min_days=prev_days
    min_pos=0
    for j in range(1,len(food)):
        good=False
        i=0
        while (i<j):
            if b[i]-1>=b[i+1]:
                if b[i]>1:
                    days=min(food[i]//(b[i]-1),
                    food[j]//(b[j]+1))
                else:
                    days=-1


                if days>=prev_days:
                    prev_days=days
                    if (min_days>prev_days):
                       min_days=prev_days
                       if food[i]//(b[i]-1)<food[j]//(b[j]+1):
                          min_pos=i
                       else:
                          min_pos=j
                    if (min_pos!=i)and(min_pos!=j):
                       prev_days=min_days
                    b[i]-=1
                    b[j]+=1
                    good=True
                    i-=1
            i+=1
        
        if not(good):
            break
    print(prev_days)
rewrite:
    ans = 0
    for days in range(100, 0, -1):
        to = 0
        for x in food:
            to += x // days
        if to >= n:
            ans = days
            break
    print(ans)

rule fix_final_answer_print
symptoms: wrong
match: print(prev_days)
rewrite: print(ans)

