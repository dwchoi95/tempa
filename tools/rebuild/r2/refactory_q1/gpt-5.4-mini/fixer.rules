rule seqsearch_empty_seq_returns_zero
symptoms: wrong, err:IndexError
match:
    if $cond:
        return $r
where:
    some($cond, "$s:Name == ()") or some($cond, "$s:Name == []") or some($cond, "len($s:Name) == 0") or some($cond, "not $s:Name")
rewrite:
    if not $s:
        return 0
    if $cond:
        return $r

rule seqsearch_fix_empty_return_none_or_bad_literal
symptoms: wrong
match:
    if $cond:
        return $r
where:
    some($cond, "seq == ()") or some($cond, "seq == []") or some($cond, "not seq")
    and text($r) != "0"
rewrite:
    if $cond:
        return 0

rule seqsearch_fix_strict_lt_to_lte_in_returning_loop
symptoms: wrong
match:
    for $i in $it:
        if $x < $e:
            return $r
where:
    bound($x) and bound($e) and text($r) == text($i)
rewrite:
    for $i in $it:
        if $x <= $e:
            return $r

rule seqsearch_fix_strict_gt_to_gte_in_returning_loop
symptoms: wrong
match:
    for $i in $it:
        if $x > $e:
            return $r
where:
    bound($x) and bound($e) and text($r) == text($i)
rewrite:
    for $i in $it:
        if $x >= $e:
            return $r

rule seqsearch_fix_return_len_minus_one_to_len
symptoms: wrong
match:
    return len($s) - 1
rewrite:
    return len($s)

rule seqsearch_fix_return_i_plus_one_to_len_when_no_match
symptoms: wrong
match:
    for $i in range(len($s)):
        if $c:
            return $r
    return $i + 1
where:
    text($r) == text($i)
rewrite:
    for $i in range(len($s)):
        if $c:
            return $r
    return len($s)

rule seqsearch_fix_break_after_condition_to_return
symptoms: wrong
match:
    for $i in range($n):
        if $c:
            break
    return $i
rewrite:
    for $i in range($n):
        if $c:
            return $i
    return $n

rule seqsearch_fix_else_return_len_inside_loop
symptoms: wrong
match:
    for $i in range(len($s)):
        if $cond:
            return $r1
        else:
            return $r2
where:
    text($r2) != "len(seq)" and text($r2) != "len($s)"
rewrite:
    for $i in range(len($s)):
        if $cond:
            return $r1
    return len($s)

rule seqsearch_fix_compare_element_to_x_not_x_to_element
symptoms: wrong
match:
    for $i, $e in enumerate($seq):
        if $e < $x:
            continue
        elif $e == $x:
            return $r1
        elif $e > $x:
            return $r2
rewrite:
    for $i, $e in enumerate($seq):
        if $x < $e:
            continue
        elif $x == $e:
            return $r1
        elif $x > $e:
            return $r2

rule seqsearch_fix_assignment_loop_counting_up
symptoms: wrong
match:
    $c = 0
    for $e in $seq:
        if $x > $e:
            $c += 1
    return $c
rewrite:
    $c = 0
    for $e in $seq:
        if $x > $e:
            $c += 1
        else:
            break
    return $c

rule seqsearch_fix_while_increment_by_one
symptoms: wrong
match:
    while $i < len($seq):
        if $x > $seq[$i]:
            $i += $i
        else:
            return $i
    return $i
rewrite:
    while $i < len($seq):
        if $x > $seq[$i]:
            $i += 1
        else:
            return $i
    return $i

rule seqsearch_fix_if_returning_previous_index
symptoms: wrong
match:
    while $i < len($seq):
        if $x > $seq[$i]:
            $i += 1
        else:
            return $i - 1
    return $i - 1
rewrite:
    while $i < len($seq):
        if $x > $seq[$i]:
            $i += 1
        else:
            return $i
    return $i

rule seqsearch_fix_range_len_minus_one_to_len
symptoms: wrong
match:
    for $i in range(len($seq) - 1):
        $B:Stmts
    return len($seq) + 1
rewrite:
    for $i in range(len($seq)):
        $B
    return len($seq)

rule seqsearch_fix_return_zero_on_empty_after_loop
symptoms: wrong
match:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return 0
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)