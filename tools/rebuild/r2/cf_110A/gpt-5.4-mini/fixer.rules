rule fix_yes_no_case_and_spelling
symptoms: wrong
match: print($s)
where: text($s) in {"'Yes'", '"Yes"', "'No'", '"No"', "'yes'", '"yes"', "'no'", '"no"', "'si'", '"si"', "'no'", '"no'"}
rewrite: print(${map[$s]})
table map: {"'Yes'": "'YES'", '"Yes"': '"YES"', "'No'": "'NO'", '"No"': '"NO"', "'yes'": "'YES'", '"yes"': '"YES"', "'no'": '"NO"', '"no"': '"NO"', "'si'": "'YES'", '"si"': '"YES"'}
rule fix_printed_sentence_instead_of_yes_no
symptoms: wrong
match: print(f$fmt)
where: regex($fmt, r"^['\"].*nearly lucky.*['\"]$")
rewrite: print("YES")

rule fix_digit_variable_used_instead_of_remainder
symptoms: wrong
match:
    $r = $n % 10
    if $n == 4 or $n == 7:
        $count += 1
where: bound($r) and bound($n) and bound($count)
rewrite:
    $r = $n % 10
    if $r == 4 or $r == 7:
        $count += 1

rule fix_digit_variable_used_instead_of_remainder_cmp
symptoms: wrong
match: if $n == 4 or $n == 7:
where: inside("while $c: $_")
rewrite: if $r == 4 or $r == 7:

