rule fix_all_digits_must_be_lucky_to_count_lucky_digits
symptoms: wrong
match:
    for $i in $s:
        if $i not in ["4","7"]:
            $out = "NO"
    print($out)
rewrite:
    count = 0
    for $i in $s:
        if $i in ["4","7"]:
            count += 1
    print("YES" if count in [4, 7] else "NO")

rule fix_all_digits_must_be_lucky_to_count_lucky_digits_break
symptoms: wrong
match:
    for $i in $s:
        if $i != '4' and $i != '7':
            $flag = False
    if $flag:
        print("YES")
    else:
        print("NO")
rewrite:
    count = 0
    for $i in $s:
        if $i == '4' or $i == '7':
            count += 1
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

rule fix_all_digits_with_length_check
