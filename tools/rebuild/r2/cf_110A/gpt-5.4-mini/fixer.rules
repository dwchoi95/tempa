rewrite: print("YES" if $count in (4, 7) else "NO")

rule fix_sum_of_counts_then_compare
symptoms: wrong
match:
    $a = $s.count("4")
    $b = $s.count("7")
    if ($a+$b)-len($s)==0:
        print("YES")
    else:
        print("NO")
rewrite:
    $a = $s.count("4")
    $b = $s.count("7")
    if $a + $b in (4, 7):
        print("YES")
    else:
        print("NO")

rule fix_len_check_to_lucky_count
