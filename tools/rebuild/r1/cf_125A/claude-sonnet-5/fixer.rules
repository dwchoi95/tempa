rule missing_inch_carry
symptoms: wrong
match:
    print($feet, $inches)
    |
    print($feet, $inches, end=$e)
    |
    print("{} {}".format($feet, $inches))
    |
    print(f"{$feet} {$inches}")
where: last()
rewrite:
    print($feet + ($inches)//12, $inches % 12)
    |
    print($feet + ($inches)//12, $inches % 12, end=$e)
    |
    print("{} {}".format($feet + ($inches)//12, $inches % 12))
    |
    print(f"{$feet + ($inches)//12} {$inches % 12}")

rule drop_trailing_space_end
symptoms: wrong
match: print($*args, end=$e)
where: text($e) == "' '" or text($e) == '" "'
rewrite: print($*args)

rule rounding_offset_plus_two
symptoms: wrong
match: ($n + $c:Int) // 3
where: $c == 2
rewrite: ($n + 1) // 3

rule double_round_feet_then_inch
symptoms: wrong
match:
    $feet = int($n / 36 + 0.5)
    $r = $n - 36 * $feet
    $inch = int($r / 3 + 0.5)
rewrite:
    $inch = int($n / 3 + 0.5)
    $feet = int($inch / 12)
    $r = $inch - 12 * $feet

rule missing_int_cast_output
symptoms: wrong
match:
    print(str($a // $b)+' '+str($a % $b))
    |
    print($a // $b, $a % $b)
rewrite:
    print(str(int($a // $b))+' '+str(int($a % $b)))
    |
    print(int($a // $b), int($a % $b))

rule add_remainder_instead_of_carry_one
symptoms: wrong
match: $n // 3 + $n % 3
rewrite: $n // 3 + 1

rule self_name_compare_instead_of_param
symptoms: wrong
match: if $f == $k:
where: inside("def $f($p): $B:Stmts")
rewrite: if $p <= $k:

rule wrong_modulus_should_be_36
symptoms: wrong
match: $n % 26
where: prev("$f:Name = $n // 36")
rewrite: $n % 36