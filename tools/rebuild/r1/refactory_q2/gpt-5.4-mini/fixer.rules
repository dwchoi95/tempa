            return True
    return False

rule fix_contains_unique_day_return_true_only_when_match
symptoms: wrong
match:
    for $i in $seq:
        if $m == $i[0]:
            if unique_day($d, $pb):
                return True
    return False
where: some($m, "month") or some($m, "months")
rewrite:
    for $i in $seq:
        if $m == $i[0]:
            if unique_day($d, $pb):
                return True
    return False

rule fix_contains_unique_day_wrong_month_field
symptoms: wrong
match:
    for $i in $seq:
        if $m == $i[1]:
            if unique_day($d, $pb):
                return True
    return False
where: some($m, "month")
rewrite:
    for $i in $seq:
        if $m == $i[0]:
            if unique_day($d, $pb):
                return True
    return False

rule fix_contains_unique_day_pass_through
symptoms: wrong
match: return
rewrite:
    for $i in possible_birthdays:
        if $i[0] == month:
            if unique_day($i[1], possible_birthdays):
                return True
    return False
where: inside("def contains_unique_day($month, $possible_birthdays): $B:Stmts") and not some($B, "return True")