rule fix_for_list_param_name
symptoms: wrong
match:
    for $x in list:
        $B:Stmts
where: inside("def $f($p, $*ys): $Body:Stmts") and text($p) != "list"
rewrite:
    for $x in $p:
        $B

rule fix_for_values_param_name
symptoms: wrong
match:
    for $x in list:
        $B:Stmts
where: inside("def $f($p, $*ys): $Body:Stmts") and text($p) == "values"
rewrite:
    for $x in $p:
        $B

rule fix_return_wrong_name
symptoms: wrong
match: return $x
where: inside("def $f($p, $*ys): $Body:Stmts") and some($Body, "output = []") and text($x) != "output" and text($x) != $p
rewrite: return output

rule fix_return_new_list_name
symptoms: wrong
match: return $x
where: inside("def $f($p, $*ys): $Body:Stmts") and some($Body, "new_lst = []") and text($x) != "new_lst" and text($x) != $p
rewrite: return new_lst

rule fix_return_output_name
symptoms: wrong
match: return $x
where: inside("def $f($p, $*ys): $Body:Stmts") and some($Body, "output = []") and text($x) != "output"
rewrite: return output

