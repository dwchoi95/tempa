rewrite:
    x = abs(int(input()))

    if x == 0:
        print(0)
    else:
        n = (-1+pow(1+4*2*x, 0.5))/2

rule fix_parity_search_return
symptoms: wrong
match:
    if sum==x:
        print(i)
    elif sum>x:
        a=(sum-x)*2+i
        sum-=i
        b=i+(x-sum)*2-1
        if a>=b:
            print(b)
        elif a<b:
            print(a)
rewrite:
    if sum==x:
        print(i)
    else:
        a=(sum-x)*2+i
        sum-=i
        b=i+(x-sum)*2-1
        if a>=b:
            print(b)
        elif a<b:
            print(a)