rule abs_input_normalization
symptoms: wrong
match: x = int(input())
where: not some(next("x = int(input())"), "x = abs(x)") and not some(next("x = int(input())"), "x = abs(int(input()))")
rewrite:
    x = abs(int(input()))

rule binary_search_parity_fix
symptoms: wrong
match:
    x=(b*(b+1))//2
    if((x-n)%2==0):
        return b
    return b+1
rewrite:
    x=(b*(b+1))//2
    if((x-n)%2==0):
        return b
    return b+2

rule wrong_direction_branch_to_abs_jump
symptoms: wrong
match:
    if n_p <= x:
        cur_pos += jump
    if n_p > x:
        cur_pos -= jump
rewrite:
    if n_p <= x:
        cur_pos += jump
    if n_p > x:
        cur_pos += jump

rule compare_towards_target_in_loop
symptoms: wrong
match:
    if num+ans+1 <= x: 
        ans += 1
        num += ans
    
    elif num+ans+1 > x: 
        ans += 1
        num -= ans
rewrite:
    if num+ans+1 <= x: 
        ans += 1
        num += ans
    
    elif num+ans+1 > x: 
        ans += 1
        num += ans

rule missing_zero_case_before_formula
