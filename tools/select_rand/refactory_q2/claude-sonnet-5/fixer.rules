rule stub_unique_day_return
symptoms: wrong, err:TypeError
match: return
where: inside("def unique_day($d, $pb): $B:Stmts") and len($B) == 1
rewrite:
    count = 0
    for entry in $pb:
        if entry[1] == $d:
            count += 1
    return count == 1

rule stub_unique_day_pass
symptoms: wrong, err:TypeError
match: pass
where: inside("def unique_day($d, $pb): $B:Stmts") and len($B) == 1
rewrite:
    count = 0
    for entry in $pb:
        if entry[1] == $d:
            count += 1
    return count == 1

rule stub_unique_month_return
symptoms: wrong, err:TypeError
match: return
where: inside("def unique_month($m, $pb): $B:Stmts") and len($B) == 1
rewrite:
    count = 0
    for entry in $pb:
        if entry[0] == $m:
            count += 1
    return count == 1

