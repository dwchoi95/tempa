rule stub_contains_unique_day_return
symptoms: wrong, err:TypeError
match: return
where: inside("def contains_unique_day($m, $pb): $B:Stmts") and len($B) == 1
rewrite:
    for entry in $pb:
        if entry[0] == $m:
            if unique_day(entry[1], $pb):
                return True
    return False

rule stub_contains_unique_day_pass
