            if unique_day(entry[1], $pb):
                return True
    return False

rule bool_flag_to_count
symptoms: wrong
match:
    $v = True
    for $k in $pb:
        if $k[$idx:Int] == $key:
            $v = False
    return $v
rewrite:
    count = 0
    for $k in $pb:
        if $k[$idx] == $key:
            count += 1
    return count == 1

rule fix_unique_day_slice_membership
symptoms: wrong
match:
    if $d in $pb[1:]:
        return False
    else:
        return True
rewrite:
    count = 0
    for entry in $pb:
        if entry[1] == $d:
            count += 1
    return count == 1

