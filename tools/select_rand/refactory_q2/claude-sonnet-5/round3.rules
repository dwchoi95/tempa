rule stub_contains_unique_day_return
symptoms: wrong
match: return
where: first() and last() and inside("def contains_unique_day($month, $pb): $B:Stmts")
rewrite:
    for $bd in $pb:
        if $bd[0] == $month:
            c = 0
            for $bd2 in $pb:
                if $bd2[1] == $bd[1]:
                    c = c + 1
            if c == 1:
                return True
    return False

rule stub_contains_unique_day_pass
symptoms: wrong
match: pass
where: first() and last() and inside("def contains_unique_day($month, $pb): $B:Stmts")
rewrite:
    for $bd in $pb:
        if $bd[0] == $month:
            c = 0
            for $bd2 in $pb:
                if $bd2[1] == $bd[1]:
                    c = c + 1
            if c == 1:
                return True
    return False

rule stub_unique_day_return
symptoms: wrong
match: return
where: first() and last() and inside("def unique_day($day, $pb): $B:Stmts")
rewrite:
    count = 0
    for $bd in $pb:
        if $bd[1] == $day:
            count = count + 1
    return count == 1

rule stub_unique_day_pass
