rule fix_unique_day_counting_bool_or_truthy
symptoms: wrong
match:
    def unique_day($p1:Name, $p2:Name):
        $B:Stmts
where:
    some($B, "return $X")
    and some($B, "$c:Name = True")
    and some($B, "if $v == $p1:\n    $c = False")
rewrite:
    def unique_day($p1:Name, $p2:Name):
        count = 0
        for birthday in $p2:
            if birthday[1] == $p1:
                count += 1
        return count == 1

