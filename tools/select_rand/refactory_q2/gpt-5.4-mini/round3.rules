                return True
        return False

rule fix_contains_unique_day_wrong_month_return
symptoms: wrong
match:
    def contains_unique_day($m:Name, $bdays:Name):
        $B:Stmts
where:
    some($B, "if $m == $x[0]:\n    return unique_day($x[1], $bdays)")
       or some($B, "if $m == $x[0]:\n    if unique_day($x[1], $bdays):\n        return True\n    else:\n        return False")
rewrite:
    def contains_unique_day($m:Name, $bdays:Name):
        for birthday in $bdays:
            if birthday[0] == $m and unique_day(birthday[1], $bdays):
                return True
        return False

rule fix_contains_unique_day_need_loop_not_single_return
