rule fix_contains_unique_day_use_any_unique_day
symptoms: wrong
match:
    def contains_unique_day($m:Name, $bdays:Name):
        $B:Stmts
where:
    some($B, "for $x in $ys:\n    if unique_day($x, $bdays):\n        return True")
       or some($B, "for $x in $ys:\n    if unique_day($x, $bdays) == True:\n        return True")
rewrite:
    def contains_unique_day($m:Name, $bdays:Name):
        for birthday in $bdays:
            if birthday[0] == $m and unique_day(birthday[1], $bdays):
                return True
        return False

rule fix_contains_unique_day_tuple_of_days
