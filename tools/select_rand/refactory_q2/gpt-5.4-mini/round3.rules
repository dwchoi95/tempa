rule fix_unique_day_misused_membership_or_string
symptoms: wrong
match:
    def unique_day($p1:Name, $p2:Name):
        $B:Stmts
where:
    some($B, "if $p1 in $x:\n    return True\nelse:\n    return False")
       or some($B, "if int($p1) in $x:\n    return False\nelse:\n    return True")
rewrite:
    def unique_day($p1:Name, $p2:Name):
        count = 0
        for birthday in $p2:
            if birthday[1] == $p1:
                count += 1
        return count == 1

