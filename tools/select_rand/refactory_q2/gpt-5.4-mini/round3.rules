rule fix_wrong_month_index_in_unique_month_and_contains
symptoms: wrong
match:
    def unique_month($m:Name, $bdays:Name):
        $U:Stmts
    def contains_unique_day($m2:Name, $bdays2:Name):
        $C:Stmts
where:
    some($U, "if $m == $x[1]:")
       or some($U, "if $x[1] == $m:")
       or some($C, "if $m2 == $x[1]:")
rewrite:
    def unique_month($m:Name, $bdays:Name):
        count = 0
        for birthday in $bdays:
            if birthday[0] == $m:
                count += 1
        return count == 1
    def contains_unique_day($m2:Name, $bdays2:Name):
        for birthday in $bdays2:
            if birthday[0] == $m2 and unique_day(birthday[1], $bdays2):
                return True
        return False

rule fix_generic_day_index_misuse_in_unique_day
symptoms: wrong
match:
    def unique_day($d:Name, $bdays:Name):
        $B:Stmts
where:
    some($B, "if $d in $x:")
       or some($B, "if $d == $x[0]:")
       or some($B, "if $d == $x[2]:")
rewrite:
    def unique_day($d:Name, $bdays:Name):
        count = 0
        for birthday in $bdays:
            if birthday[1] == $d:
                count += 1
        return count == 1

