rule lucky_digit_count_then_divisibility_check_to_lucky_count_check
symptoms: wrong
match:
    count = $E
    if $C % 4 == 0 or $C % 7 == 0:
        print($Y)
    else:
        print($N)
where: text($Y) == "\"YES\"" and text($N) == "\"NO\"" and (
    match($E, "$X.count('4') + $X.count('7')") or
    match($E, "$X.count('7') + $X.count('4')")
)
rewrite:
    count = $E
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

