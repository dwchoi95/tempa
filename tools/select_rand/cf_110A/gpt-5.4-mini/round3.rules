rule lucky_digit_membership_to_count
symptoms: wrong
match:
    for $v in $S:
        if $v in $L:
            $B:Stmts
where: some($B, "print(\"YES\")") and some($B, "print(\"NO\")")
rewrite:
    count = 0
    for $v in $S:
        if $v == '4' or $v == '7':
            count += 1
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

