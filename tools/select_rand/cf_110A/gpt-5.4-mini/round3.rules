rule digit_scan_else_break_to_count_scan
symptoms: wrong
match:
    for $d in $s:
        if $d != '4' and $d != '7':
            $B1:Stmts
            break
        $B2:Stmts
where: some($B1, "print(\"NO\")") or some($B2, "print(\"YES\")")
rewrite:
    count = 0
    for $d in $s:
        if $d == '4' or $d == '7':
            count += 1
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

rule lucky_digit_count_return_to_lucky_number_return
symptoms: wrong
match:
    def $f($*xs):
        $B:Stmts
    $r = $f($arg)
where: some($B, "return is_lucky_digit(str(count))") or some($B, "return is_lucky_digit(lucky_count)") or some($B, "return is_lucky_digit(count)")
rewrite:
    def $f($*xs):
        $B
    $r = $f($arg)

