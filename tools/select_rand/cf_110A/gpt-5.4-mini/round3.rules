rule print_count_and_answer_to_lucky_count_only
symptoms: wrong
match:
    for $i in $entrada:
        if $i == "4" or $i == "7":
            $cnt += 1
    if $cnt == 4 or $cnt == 7:
        print("YES")
    else:
        print("NO")
    print($cnt)
rewrite:
    for $i in $entrada:
        if $i == "4" or $i == "7":
            $cnt += 1
    if $cnt == 4 or $cnt == 7:
        print("YES")
    else:
        print("NO")

rule print_list_debug_to_plain_input
