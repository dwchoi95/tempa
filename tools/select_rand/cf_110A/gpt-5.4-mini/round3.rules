rule lucky_set_equality_to_count_check
symptoms: wrong
match:
    if $S == {'4', '7'}:
        print($Y)
    else:
        if $A:
            print($Y2)
        else:
            print($N)
where: text($Y) == "\"YES\"" and text($Y2) == "\"YES\"" and text($N) == "\"NO\""
rewrite:
    count = 0
    for ch in $X:
        if ch == '4' or ch == '7':
            count += 1
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

rule lucky_bool_initialization_to_count_check
symptoms: wrong
match:
    lucky = True
    while $num > 0:
        if ($num % 10) == 4 or ($num % 10) == 7:
            lucky = True
            $num //= 10
        else:
            lucky = False
            break
    if lucky == True:
        print($Y)
    else:
        print($N)
where: text($Y) == "\"YES\"" and text($N) == "\"NO\""
rewrite:
    count = 0
    while $num > 0:
        if ($num % 10) == 4 or ($num % 10) == 7:
            count += 1
        $num //= 10
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

