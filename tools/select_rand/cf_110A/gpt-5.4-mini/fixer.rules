rule fix_return_wrong_lucky_digit_check
symptoms: wrong
match:
    return $f($count)
where: match($f, "$g:Name") and text($g) != "is_lucky_digit"
rewrite:
    return $count == 4 or $count == 7

rule fix_bool_loop_or_condition_to_counting
symptoms: wrong
match:
    for $i in $s:
        if $i != '4' and $i != '7':
            $flag = False
            break
    print("YES" if $flag == True else "NO")
rewrite:
    count = 0
    for $i in $s:
        if $i == '4' or $i == '7':
            count += 1
    if count == 4 or count == 7:
        print("YES")
    else:
        print("NO")

rule fix_input_print_noise
symptoms: wrong
match:
    print($x)
    print($y)
where: text($x) != text($y)
rewrite:
    print($x)