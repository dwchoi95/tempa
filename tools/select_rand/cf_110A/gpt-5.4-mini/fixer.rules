rule lucky_digit_count_then_lucky_number_check
symptoms: wrong
match:
    $count = 0
    while $n != 0:
        if $n % 10 == 4 or $n % 10 == 7:
            $count += 1
        $n = $n // 10
    if $count == 4 or $count == 7:
        print("YES")
    else:
        print("NO")
rewrite:
    $count = 0
    while $n != 0:
        if $n % 10 == 4 or $n % 10 == 7:
            $count += 1
        $n = $n // 10
    if $count == 4 or $count == 7:
        print("YES")
    else:
        print("NO")

rule fix_wrong_any_lucky_digit
symptoms: wrong
match:
    if '4' in $x or '7' in $x:
        print("YES")
    else:
        print("NO")
rewrite:
    if $x.count('4') + $x.count('7') == 4 or $x.count('4') + $x.count('7') == 7:
        print("YES")
    else:
        print("NO")

rule fix_set_exactly_two_digits
symptoms: wrong
match:
    if set($x) == {'4', '7'} or set($x) == {'7', '4'}:
        print('YES')
    else:
        print('NO')
rewrite:
    if $x.count('4') + $x.count('7') == 4 or $x.count('4') + $x.count('7') == 7:
        print('YES')
    else:
        print('NO')

rule fix_counter_divisibility_misconception
symptoms: wrong
match:
    $c = $s.count('4') + $s.count('7')
    if $c == 0:
        print('NO')
    elif $c % 4 == 0 or $c % 7 == 0:
        print('YES')
    else:
        print('NO')
rewrite:
    $c = $s.count('4') + $s.count('7')
    if $c == 4 or $c == 7:
        print('YES')
    else:
        print('NO')

rule fix_count_equals_length_or_nonlucky
