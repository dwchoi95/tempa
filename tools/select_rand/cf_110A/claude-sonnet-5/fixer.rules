rule count_eq_len_should_be_lucky_count
symptoms: wrong
match: $c == len($s)
rewrite: $c == 4 or $c == 7

rule len_eq_count_should_be_lucky_count
symptoms: wrong
match: len($s) == $c
rewrite: $c == 4 or $c == 7

rule length_as_lucky_count_or
symptoms: wrong
match: len($n) == 4 or len($n) == 7
rewrite: ($n.count('4') + $n.count('7')) in (4, 7)

rule length_as_lucky_count_or_rev
symptoms: wrong
match: len($n) == 7 or len($n) == 4
rewrite: ($n.count('4') + $n.count('7')) in (4, 7)

rule length_as_lucky_count_bitor
symptoms: wrong
match: len($n) == 7 | len($n) == 4
rewrite: ($n.count('4') + $n.count('7')) in (4, 7)

rule modulo_should_be_equality
symptoms: wrong
match: $c % 4 == 0 or $c % 7 == 0
rewrite: $c == 4 or $c == 7

rule modulo_should_be_equality_rev
symptoms: wrong
match: $c % 7 == 0 or $c % 4 == 0
rewrite: $c == 4 or $c == 7

rule modulo_nonzero_guard
symptoms: wrong
match: ($c % 4 == 0 or $c % 7 == 0) and $c != 0
rewrite: $c == 4 or $c == 7

rule modulo_nonzero_guard_rev
symptoms: wrong
match: ($c % 7 == 0 or $c % 4 == 0) and $c != 0
rewrite: $c == 4 or $c == 7

rule set_equals_47
symptoms: wrong
match: set($s) == {$a, $b}
where: text($a) in {"'4'", "'7'"} and text($b) in {"'4'", "'7'"} and text($a) != text($b)
rewrite: ($s.count('4') + $s.count('7')) in (4, 7)

rule set_equals_47_rev
symptoms: wrong
match: {$a, $b} == set($s)
where: text($a) in {"'4'", "'7'"} and text($b) in {"'4'", "'7'"} and text($a) != text($b)
rewrite: ($s.count('4') + $s.count('7')) in (4, 7)

rule precomputed_set_var_equals_47
symptoms: wrong
match:
    if $v == {$a, $b}:
        print("YES")
    else:
        print("NO")
where: prev("$v = set($s)") and text($a) in {"'4'", "'7'"} and text($b) in {"'4'", "'7'"} and text($a) != text($b)
rewrite:
    if ($s.count('4') + $s.count('7')) in (4, 7):
        print("YES")
    else:
        print("NO")

rule remove_presence_guard
symptoms: wrong
match:
    if $s.count($a) == 0 or $s.count($b) == 0:
        print("NO")
    else:
        $REST:Stmts
where: text($a) in {"'4'", "'7'"} and text($b) in {"'4'", "'7'"} and text($a) != text($b)
rewrite: $REST

rule remove_all_lucky_guard
symptoms: wrong
match: $flag == 0 and ($c == 4 or $c == 7)
rewrite: $c == 4 or $c == 7

rule length_assigned_as_count_before_flag_init
symptoms: wrong
match: $c = len($b)
where: next("$flag = 0")
rewrite: $c = $b.count('4') + $b.count('7')

rule assign_length_should_be_lucky_count
symptoms: wrong
match: $a = len($n)
where: next("if $a == 4:")
rewrite: $a = $n.count('4') + $n.count('7')

rule fix_lowercase_yes
symptoms: wrong
match: print("yes")
rewrite: print("YES")

rule fix_lowercase_no
symptoms: wrong
match: print("no")
rewrite: print("NO")

rule fix_titlecase_yes
symptoms: wrong
match: print("Yes")
rewrite: print("YES")

rule fix_titlecase_no
symptoms: wrong
match: print("No")
rewrite: print("NO")

rule remove_break_in_counting_loop_augassign
symptoms: wrong
match:
    if $cond:
        $c += 1
    else:
        break
where: regex($cond, "4") and regex($cond, "7")
rewrite:
    if $cond:
        $c += 1

rule remove_break_in_counting_loop_assign
symptoms: wrong
match:
    if $cond:
        $c = $c + 1
    else:
        break
where: regex($cond, "4") and regex($cond, "7")
rewrite:
    if $cond:
        $c = $c + 1

rule while_digit_allflag_to_count
symptoms: wrong
match:
    while $n > 0:
        if $n % 10 == 4 or $n % 10 == 7:
            $flag = True
            $n //= 10
        else:
            $flag = False
            break
    if $flag:
        print("YES")
    else:
        print("NO")
rewrite:
    _cnt = 0
    while $n > 0:
        if $n % 10 == 4 or $n % 10 == 7:
            _cnt += 1
        $n //= 10
    if _cnt == 4 or _cnt == 7:
        print("YES")
    else:
        print("NO")

rule while_digit_allflag_to_count_eqtrue
symptoms: wrong
match:
    while $n > 0:
        if $n % 10 == 4 or $n % 10 == 7:
            $flag = True
            $n //= 10
        else:
            $flag = False
            break
    if $flag == True :
        print("YES")
    else:
        print("NO")
rewrite:
    _cnt = 0
    while $n > 0:
        if $n % 10 == 4 or $n % 10 == 7:
            _cnt += 1
        $n //= 10
    if _cnt == 4 or _cnt == 7:
        print("YES")
    else:
        print("NO")

rule for_loop_poscond_flag_break_to_count
symptoms: wrong
match:
    for $i in $s:
        if $cond:
            $flag = True
        else:
            $flag = False
            break
    if $flag == True:
        print("YES")
    else:
        print("NO")
where: regex($cond, "4") and regex($cond, "7")
rewrite:
    _cnt = 0
    for $i in $s:
        if $cond:
            _cnt += 1
    if _cnt == 4 or _cnt == 7:
        print("YES")
    else:
        print("NO")

rule for_loop_strflag_break_to_count
symptoms: wrong
match:
    for $i in $s:
        if $cond:
            $flag = "NO"
            break
    print($flag)
where: regex($cond, "4") and regex($cond, "7")
rewrite:
    _cnt = 0
    for $i in $s:
        if $i == '4' or $i == '7':
            _cnt += 1
    print("YES" if (_cnt == 4 or _cnt == 7) else "NO")

