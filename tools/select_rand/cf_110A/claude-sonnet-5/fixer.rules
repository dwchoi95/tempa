rule for_loop_return_noloop_notin
symptoms: wrong
match:
    for $i in $s:
        if $i not in "47":
            return "NO"
    return "YES"
rewrite:
    _cnt = 0
    for $i in $s:
        if $i in "47":
            _cnt += 1
    return "YES" if (_cnt == 4 or _cnt == 7) else "NO"

