rule unique_char_list_equals_47_list
symptoms: wrong
match:
    if $l1 == $l2 or $l2 == $l3:
        print('YES')
    else:
        print('NO')
where: match($l1, "['4', '7']") and match($l3, "['7', '4']") and before("for $ch2 in $s:\n    if $ch2 not in $l2:\n        $l2.append($ch2)")
rewrite:
    _cnt = 0
    for _ch in $s:
        if _ch == '4' or _ch == '7':
            _cnt += 1
    if _cnt == 4 or _cnt == 7:
        print('YES')
    else:
        print('NO')