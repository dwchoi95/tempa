rule digit_root_only_whole_program
symptoms: wrong
match:
    def $f($n):
        $BODY:Stmts
    print($f($arg))
where: some($BODY, "sum(int($d) for $d in str($m))")
rewrite:
    from math import sqrt, floor
    n = int(input())
    true_products, a = 0, 1
    while a ** 2 <= n:
        true_products += n // a - a
        a += 1
    true_products *= 2
    true_products += a - 1
    digit_roots = [n // 9 for _ in range(9)]
    for i in range(1, n % 9 + 1):
        digit_roots[i] += 1
    digit_root_products = 0
    for i in range(9):
        for j in range(9):
            digit_root_products += digit_roots[i] * digit_roots[j] * digit_roots[(i * j) % 9]
    print(digit_root_products - true_products)

rule bruteforce_digit_root_bound_misconception
symptoms: wrong, timeout
match:
    for $i in range($lo, $n + 1):
        $BODY:Stmts
where:
    some($BODY, "if $c < $n + 1 and $c != $a2 * $b2:")
    and some($BODY, "$acc:Name = $acc + $_")
rewrite:
    true_products, a = 0, 1
    while a ** 2 <= $n:
        true_products += $n // a - a
        a += 1
    true_products *= 2
    true_products += a - 1
    digit_roots = [$n // 9 for _ in range(9)]
    for i in range(1, $n % 9 + 1):
        digit_roots[i] += 1
    digit_root_products = 0
    for i in range(9):
        for j in range(9):
            digit_root_products += digit_roots[i] * digit_roots[j] * digit_roots[(i * j) % 9]
    $acc = digit_root_products - true_products

rule membership_missing_else_offset
symptoms: wrong
match:
    if $j not in $coll:
        $acc:Name = $acc + $l
    |
    if $j not in $coll:
        $acc:Name += $l
rewrite:
    if $j not in $coll:
        $acc = $acc + $l
    else:
        $acc = $acc + $l - 1