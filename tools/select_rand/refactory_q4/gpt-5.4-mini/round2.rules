rule remove_append_of_wrong_item_after_scan
symptoms: wrong
match:
    $lst.remove($wrong)
    $out.append($wrong)
where:
    some($wrong, "$wrong[1]") and some($lst, "$correct:Name[1]") and $wrong != $correct
rewrite:
    $lst.remove($correct)
    $out.append($correct)

rule fix_remove_append_using_last_loop_var
symptoms: wrong
match:
    $lst.remove($x)
    $out.append($x)
where:
    inside("while $c:\n    $B:Stmts") and some($B, "for $v in $lst:\n    $I:Stmts") and load($x) and text($x) == text($v)
rewrite:
    $lst.remove($best)
    $out.append($best)

rule compare_ages_not_tuples
symptoms: wrong
match: if $a $o:Cmp $b:
where:
    (match($a, "$x[1]") and match($b, "$y") and not match($b, "$y[1]")) or
    (match($b, "$x[1]") and match($a, "$y") and not match($a, "$y[1]"))
rewrite: if $a ${cmp[$o]} $b:
table cmp: {"<": "<", ">": ">", "<=": "<=", ">=": ">=", "==": "==", "!=": "!="}

rule fix_negative_sort_to_descending_selection
symptoms: wrong
match:
    lst.sort(key = lambda x: x[1])
    return lst
rewrite:
    sort = []
    while lst:
        biggest = lst[0]
        for element in lst:
            if element[1] > biggest[1]:
                biggest = element
        lst.remove(biggest)
        sort.append(biggest)
    return sort

rule fix_reverse_sort_return_none
symptoms: wrong
match:
    $xs.sort($*args)
    return $xs
where:
    some($xs, "x[1]") and not some($xs, "reverse=True")
rewrite:
    sort = []
    while $xs:
        biggest = $xs[0]
        for element in $xs:
            if element[1] > biggest[1]:
                biggest = element
        $xs.remove(biggest)
        sort.append(biggest)
    return sort

rule fix_reverse_method_return
symptoms: wrong
match: return $x.reverse
rewrite:
    $x.reverse()
    return $x

rule fix_reverse_method_as_statement
symptoms: wrong
match:
    $x.reverse
    return $x
rewrite:
    $x.reverse()
    return $x

rule fix_wrong_tuple_age_comparison
symptoms: wrong
match:
    if $a[1] $o:Cmp $b:
where:
    text($b) in {"smallest", "largest", "oldest", "biggest"}
rewrite:
    if $a[1] $o $b[1]:

rule fix_smallest_variable_used_as_tuple
symptoms: wrong
match:
    $smallest = $lst[0][1]
    $body:Stmts
where:
    some($body, "if $x[1] < $smallest:") or some($body, "if $x[1] > $smallest:")
rewrite:
    $smallest = $lst[0]
    $body

rule fix_return_inside_loop
symptoms: wrong
match:
    while $c:
        $B1:Stmts
        return $e
rewrite:
    while $c:
        $B1
    return $e

rule fix_append_before_remove_in_while
symptoms: wrong
match:
    $lst.remove($v)
    $out.append($v)
where:
    inside("while $c:\n    $B:Stmts")
rewrite:
    $out.append($v)
    $lst.remove($v)

rule fix_remove_name_instead_of_object
symptoms: wrong
match:
    $lst.remove($v)
where:
    some($lst, "$v[1]") and not some($lst, "$v")
rewrite:
    $lst.remove($v)

rule fix_newest_then_reverse_pattern
symptoms: wrong
match:
    $out.append($v)
    $out.reverse()
rewrite:
    $out.insert(0, $v)

rule fix_range_off_by_one_sort_loop
symptoms: wrong
match:
    for $i in range(len($lst)-1):
        $body:Stmts
where:
    some($body, "$lst[$i+1]")
rewrite:
    for $i in range(len($lst)):
        $body

rule fix_bubble_swap_tuple_elements
symptoms: wrong
match:
    $lst[$i][1], $lst[$j][1] = $lst[$j][1], $lst[$i][1]
rewrite:
    $lst[$i], $lst[$j] = $lst[$j], $lst[$i]

rule fix_max_age_accumulator_initialization
symptoms: wrong
match:
    $age = 0
    $body:Stmts
where:
    some($body, "if $x[1] > $age:")
rewrite:
    $age = $lst[0]
    $body