rule ceil_rounds_one_cm_wrongly
symptoms: wrong
match:
    ceil($r / 3)
    |
    math.ceil($r / 3)
where: regex($r, r"%\s*36") or prev("$r = $_ % 36")
rewrite: ($r // 3 + ($r % 3 == 2))

rule print_end_space_to_newline
symptoms: wrong
match: print($*xs, end=$e:Str)
where: text($e) != "\\n"
rewrite: print($*xs)

rule remove_input_prompt_text
symptoms: wrong
match: input($s:Str)
rewrite: input()

rule self_referential_bool_check
symptoms: wrong
match:
    if $f == 1:
        return 0
    return 1
where: inside("def $f($p): $B:Stmts")
rewrite:
    if $p == 2:
        return 1
    return 0

rule total_inches_double_count
symptoms: wrong
match:
    $x:Name = $n // 36
    $y:Name = round($n / 3)
rewrite:
    $x = ($n + 1) // 3
    $y = $x % 12
    $x = $x // 12

rule wrong_modulus_after_div36
symptoms: wrong
match:
    $a:Name = $n:Name // 36
    $n = $n % $k:Int
where: text($k) != "36"
rewrite:
    $a = $n // 36
    $n = $n % 36

rule missing_round_before_print
symptoms: wrong
match: print($a, $n // 3)
rewrite: print($a, $n // 3 + ($n % 3 == 2))

rule add_remainder_instead_of_one
symptoms: wrong
match: $b:Name = $n:Name // 3 + $n % 3
rewrite: $b = $n // 3 + 1