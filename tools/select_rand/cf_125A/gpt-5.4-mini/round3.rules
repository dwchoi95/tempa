rule ceil_based_rounding_to_inches
symptoms: wrong
match:
    from math import ceil
    $n:Name = int(input())
    print($e1, ceil($e2))
where:
    some($e2, "$n % 36 / 3") or some($e2, "$n%36/3") or some($e2, "($n % 36) / 3")
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

rule rounded_inches_then_feet
symptoms: wrong
match:
    $n:Name = int(input())
    $a:Name = $n // 36
    $b:Name = $n % 36
    if $c % 3 == 0:
        $i:Name = $b // 3
    elif $c % 3 == 1:
        $i:Name = $b // 3
    elif $c % 3 == 2:
        $i:Name = $b // 3 + 1
    print($a, $i)
where:
    $c == $b
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

rule remainder_rounding_branch
symptoms: wrong
match:
    $n:Name = int(input())
    $a:Name = $n // 36
    $c:Name = ($n % 36)
    if $c % 3 == 2:
        $b:Name = ($c // 3) + 1
    else:
        $b:Name = $c // 3
    print($a, $b)
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

rule print_textual_feet_inches
symptoms: wrong
match:
    $from math import ceil
    $a:Name = int(input())
    $f:Name = str($a // 36)
    $d:Name = ceil($a % 36 / 3)
    if $d == 12:
        $f += 1
    print($f + ' ' + str($d))
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

rule division_then_round
symptoms: wrong
match:
    import math
    $n:Name = int(input())
    $ft:Name = $n / 36
    $frctn:Name, $intzr:Name = math.modf($ft)
    $ftss:Name = int($intzr)
    $cm:Name = round($frctn * 12)
    print($ftss, $cm)
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

rule divide_then_round_inches_only
symptoms: wrong
match:
    $n:Name = int(input())
    $f:Name = $n // 36
    $r:Name = $n % 36
    if $r % 3 == 0:
        $i:Name = $r // 3
    elif $r % 3 == 1:
        $i:Name = $r // 3
    elif $r % 3 == 2:
        $i:Name = $r // 3 + 1
    print($f, $i)
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

rule round_rem_and_keep_feet
symptoms: wrong
match:
    $centimeters:Name = int(input())
    $inches:Name = $centimeters // 3
    $feet:Name = $inches // 12
    $rem_centimeters:Name = $centimeters - $feet * 12 * 3
    $rem_inches:Name = round($rem_centimeters / 3)
    print($feet, $rem_inches)
rewrite:
    $n = int(input())
    $x = ($n + 1) // 3
    print($x // 12, $x % 12)

