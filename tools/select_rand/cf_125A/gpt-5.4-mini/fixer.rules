rule use_rounding_after_cm_to_inches
symptoms: wrong
match:
    $n = int(input())
    $feet = $n // 36
    $rem = $n % 36
    $inch = $rem // 3
    if $rem % 3 == 2:
        $inch += 1
    print($feet, $inch)
rewrite:
    $n = int(input())
    $x = ( $n + 1 ) // 3
    print($x // 12, $x % 12)

rule fix_float_round_to_integer_inches
symptoms: wrong
match:
    $a = int(input())
    $a /= 3
    if $a % 1 < 0.5:
        $a //= 1
    else:
        $a = $a // 1 + 1
    print(str($a // 12) + ' ' + str($a % 12))
rewrite:
    n = int(input())
    n = (n + 1) // 3
    print(n // 12, n % 12)

rule fix_fractional_part_rounding_and_modulo_36
symptoms: wrong
match:
    $n = int(input())
    $x1 = $n // 36
    $x2 = $n % 36
    $a = $x1
    $b1 = $x2 // 3
    $b2 = $x2 % 3
    if $b2 == 1 or $b2 == 0:
        $b = $b1
    else:
        $b = $b1 + 1
    print($a, $b, end=" ")
rewrite:
    $n = int(input())
    $a = ($n + 1) // 36
    $n -= 36 * $a
    $b = ($n + 1) // 3
    print($a, $b)

rule round_inches_then_split_to_feet_and_inches
symptoms: wrong
match:
    $centimeters = int(input())

    $inches = $centimeters // 3
    $feet = $inches // 12
    $rem_centimeters = $centimeters - $feet * 12 * 3
    $rem_inches = round($rem_centimeters / 3)

    print($feet, $rem_inches)
rewrite:
    n = int(input())
    a = n // 3
    b = 0
    if n % 3 == 2:
        a += 1
    if a >= 12:
        b = a // 12
        a = a % 12
    print(b, a)

rule fix_modulo_rounding_to_feet_inches
symptoms: wrong
match:
    $n = int(input())
    $f = $n // 36
    $r = $n % 36
    if $r % 3 == 0:
        $i = $r // 3
    elif $r % 3 == 1:
        $i = $r // 3
    elif $r % 3 == 2:
        $i = $r // 3 + 1
    print($f, $i)
rewrite:
    n = int(input())
    duim = n // 3
    if n - (duim * 3) == 2:
        duim += 1
    fut = duim // 12
    duim = duim - (fut * 12)
    print(fut, duim)

rule fix_bound_to_inches_plus_one
symptoms: wrong
match:
    $n = int(input())
    $a = int($n / 36)
    $b = $n % 36
    if $b % 3 == 0 or $b % 3 == 1:
        $b = int($b / 3)
    else:
        $b = int($b / 3) + 1
    print($a, $b)
rewrite:
    $n = int(input())
    $a = ($n + 1) // 36
    $n -= 36 * $a
    $b = ($n + 1) // 3
    print($a, $b)

rule fix_round_call_on_remainder_inches
symptoms: wrong
match:
    $n = int(input())
    $foot = $n // 36
    $left = $n - 36 * $foot
    $inch = round($left / 3)
    print("{} {}".format($foot, $inch))
rewrite:
    $n = int(input())
    $foot = $n // 36
    $left = $n - 36 * $foot
    $inch = $left // 3
    if $left % 3 == 2:
        $inch += 1
    if $inch == 12:
        $foot += 1
        $inch = 0
    print("{} {}".format($foot, $inch))

rule fix_modulo_26_typo
symptoms: wrong
match:
    $cms = int(input())
    $inch = $cms // 36
    $cms = $cms % 26
    print($inch, $cms // 3)
rewrite:
    $cms = int(input())
    $inch = $cms // 36
    $cms = $cms % 36
    print($inch, $cms // 3)

rule fix_increment_on_remainder_two
symptoms: wrong
match:
    $n = int(input())
    if $n % 3 == 0:
        $b = $n // 3
    elif $n % 3 == 2:
        $b = $n // 3 + $n % 3
    else:
        $b = $n // 3
    $a = $b // 12
    $b %= 12
    print($a, $b)
rewrite:
    n = int(input())
    x = (n + 1) // 3
    print(x // 12, x % 12)

rule fix_rounding_with_plus_two
symptoms: wrong
match:
    $n = int(input())
    $n = ($n + 2) // 3
    print($n // 12, $n % 12)
rewrite:
    n = int(input())
    n = (n + 1) // 3
    print(n // 12, n % 12)

rule fix_round_in_function_return
symptoms: wrong
match:
    def $f($*xs):
        $ft = $n // 36
        $rem = $n % 36
        $ic = round($rem / 3)
        return $ft, $ic
rewrite:
    def $f($*xs):
        $ft = $n // 36
        $rem = $n % 36
        $ic = $rem // 3
        if $rem % 3 == 2:
            $ic += 1
        if $ic == 12:
            $ft += 1
            $ic = 0
        return $ft, $ic

rule fix_round_to_nearest_inches_then_split
symptoms: wrong
match:
    $n = int(input())
    $x = round($n / 3)
    $y = $x // 12
    $z = $x - 12 * $y
    print($y, $z)
rewrite:
    $n = int(input())
    $x = ( $n + 1 ) // 3
    print($x // 12, $x % 12)

rule fix_single_value_rounding_to_feet_inches
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $b = ($n - $a * 36 + 1) // 3
    print($a, $b)
rewrite:
    $n = int(input())
    $x = $n // 3 + ($n % 3 == 2)
    print($x // 12, $x % 12)

rule fix_feet_then_remainder_inches
symptoms: wrong
match:
    $n = int(input())
    $a = $n // 36
    $c = $n % 36
    if $c % 3 == 2:
        $b = ($c // 3) + 1
    else:
        $b = $c // 3
    print($a, $b)
rewrite:
    $n = int(input())
    $a = $n // 36
    $c = $n % 36
    $b = ($c + 1) // 3
    if $b == 12:
        $a += 1
        $b = 0
    print($a, $b)

rule fix_round_call_from_float_input
symptoms: wrong
match:
    $n = float(input())
    $feet = int($n / 36 + 0.5)
    $r = $n - 36 * $feet
    $inch = int($r / 3 + 0.5)
    print($feet, '  ', $inch)
rewrite:
    n = int(input())
    a = n // 3
    b = n % 3
    if b == 2:
        a = a + 1
    p = a // 12
    q = a % 12
    print(p, q)