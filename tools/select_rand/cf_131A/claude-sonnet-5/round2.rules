rule print_slice_capitalize
symptoms: wrong
match:
    print($s[0].upper() + $s[1:].lower())
    |
    print($s[0].upper() + $s[1::].lower())
    |
    print($s[0].upper() + $s[1:].casefold())
    |
    print($s[:1].upper() + $s[1:])
rewrite:
    if len($s) == 1 or $s.isupper() or ($s[0].islower() and $s[1:].isupper()):
        print($s.swapcase())
    else:
        print($s)

