rule bare_lower_print
symptoms: wrong
match:
    $k = $s.lower()
    print($k)
rewrite:
    if len($s) == 1 or $s.isupper() or ($s[0].islower() and $s[1:].isupper()):
        $k = $s.swapcase()
    else:
        $k = $s
    print($k)

rule print_title_or_capitalize
symptoms: wrong
match:
    print($s.title())
    |
    print($s.capitalize())
rewrite:
    if len($s) == 1 or $s.isupper() or ($s[0].islower() and $s[1:].isupper()):
        print($s.swapcase())
    else:
        print($s)

