rule capslock_wrong_predicate_upper_cmp
symptoms: wrong
match:
    $k = $s.upper()
    if $k == $s:
        print($s)
    else:
        print($k[0]+$s[1:len($s)].lower())
rewrite:
    $k = $s.upper()
    if $k == $s:
        print($s.lower())
    elif $s[0].islower() and $s[1:] == $k[1:]:
        print($k[0]+$s[1:].lower())
    else:
        print($s)

