rule truthy_import_string_variant
symptoms: wrong
match:
    if $s[0].islower() and $s[1:].upper():
        print($s.capitalize())
    elif $s.upper():
        print($s)
    else:
        print($s.capitalize())
rewrite:
    if $s.isupper():
        print($s.lower())
    elif $s[0].islower() and $s[1:].isupper():
        print($s.capitalize())
    elif len($s) == 1:
        print($s.swapcase())
    else:
        print($s)

rule import_string_long_chain_missing_allupper
symptoms: wrong
match:
    if len($s) == 1:
        print($s.upper())
    elif $s.islower():
        print($s.lower())
    elif $s[0].islower() and $s[1:].upper():
        print($s.capitalize())
    elif $s.upper():
        print($s)
    else:
        print($s.capitalize())
rewrite:
    if len($s) == 1:
        print($s.upper())
    elif $s.isupper():
        print($s.lower())
    elif $s[0].islower() and $s[1:].isupper():
        print($s.capitalize())
    else:
        print($s)

rule missing_first_char_prefix
symptoms: wrong
match:
    if $s[1:].isupper():
        print($s[1:].casefold())
    else:
        print($s)
rewrite:
    if $s[1:].isupper():
        print($s[0].upper() + $s[1:].casefold())
    else:
        print($s)

rule outer_isupper_wrong_body
symptoms: wrong
match:
    if $s[0].isupper():
        print($s[0]+$s[1:].casefold())
    else:
        $REST:Stmts
rewrite:
    if $s.isupper():
        print($s.lower())
    else:
        $REST

rule missing_single_char_case_isupper_chain
symptoms: wrong
match:
    if $s.isupper():
        $s = $s.lower()
        print($s)
    elif $s[1::].isupper():
        $s = $s.title()
        print($s)
    else:
        print($s)
rewrite:
    if $s.isupper() or len($s) == 1:
        $s = $s.swapcase()
        print($s)
    elif $s[1::].isupper():
        $s = $s.title()
        print($s)
    else:
        print($s)

rule regex_swapcase_missing_singlechar
symptoms: wrong
match:
    if $cond:
        print($s.swapcase())
    else:
        print($s)
where: regex($cond, "findall")
rewrite:
    if len($s) == 1 or $cond:
        print($s.swapcase())
    else:
        print($s)

rule regex_inverted_swapcase_default
symptoms: wrong
match:
    if $cond:
        print($s)
    else:
        print($s.swapcase())
where: regex($cond, "findall")
rewrite:
    if $s.isupper() or (len($s) > 1 and $s[0].islower() and $s[1:].isupper()) or len($s) == 1:
        print($s.swapcase())
    else:
        print($s)

rule ternary_swapcase_missing_singlechar
symptoms: wrong
match: $s.swapcase() if $s[1:].isupper() else $s
rewrite: $s.swapcase() if (len($s) == 1 or $s[1:].isupper()) else $s

rule forgotten_assignment_return_variant
symptoms: wrong
match:
    $s = input().lower()
    $s[0].upper()
    return $s
rewrite:
    $s = input()
    if len($s) == 1 or $s.isupper() or ($s[0].islower() and $s[1:].isupper()):
        $s = $s.swapcase()
    return $s