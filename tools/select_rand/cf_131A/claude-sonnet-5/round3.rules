rule missing_parens_isupper_wrong_branch
symptoms: wrong
match:
    if $X.isupper:
        print($X[0].upper()+$Y.lower())
    else:
        print($X)
where: match($Y, "$X[1:]")
rewrite:
    if $X.isupper():
        print($X.lower())
    elif len($X) == 1:
        print($X.upper())
    elif $X[0].islower() and $Y.isupper():
        print($X[0].upper()+$Y.lower())
    else:
        print($X)

rule islower_should_be_isupper_in_or
symptoms: wrong
match: $X.isupper() or $Y.islower()
where: match($Y, "$X[1:]") or match($Y, "$X[1::]")
rewrite: $X.isupper() or $Y.isupper()

rule islower_should_be_isupper_len_variant
symptoms: wrong
match: $X.isupper() or (len($X) > 1 and $Y.islower())
where: match($Y, "$X[1:]") or match($Y, "$X[1::]")
rewrite: $X.isupper() or (len($X) > 1 and $Y.isupper())

rule truthy_upper_elif_chain
symptoms: wrong
match:
    if $X[0].islower() and $Y.upper():
        print($X.capitalize())
    elif $X.upper():
        print($X)
    else:
        print($X.capitalize())
where: match($Y, "$X[1:]")
rewrite:
    if $X.isupper():
        print($X.lower())
    elif len($X) == 1:
        print($X.upper())
    elif $X[0].islower() and $Y.isupper():
        print($X.capitalize())
    else:
        print($X)

rule truthy_upper_chain_5branch
symptoms: wrong
match:
    if len($X) == 1:
        print($X.upper())
    elif $X.islower():
        print($X.lower())
    elif $X[0].islower() and $Y.upper():
        print($X.capitalize())
    elif $X.upper():
        print($X)
    else:
        print($X.capitalize())
where: match($Y, "$X[1:]")
rewrite:
    if $X.isupper():
        print($X.lower())
    elif len($X) == 1:
        print($X.upper())
    elif $X[0].islower() and $Y.isupper():
        print($X.capitalize())
    else:
        print($X)

rule regex_missing_end_anchor
symptoms: wrong
match:
    if re.findall($P1, $W) or re.findall($P2, $W):
        print($W.swapcase())
    else:
        print($W)
where: text($P1) == "r'^[a-z][A-Z]+'" and text($P2) == "r'^[A-Z]+'"
rewrite:
    if $W.isupper() or len($W) == 1 or ($W[0].islower() and $W[1:].isupper()):
        print($W.swapcase())
    else:
        print($W)

rule regex_ans_or_swapcase
symptoms: wrong
match:
    ans = re.findall($P, $W)
    if ans:
        print($W)
    else:
        print($W.swapcase())
where: text($P) == "r'^[A-Z][a-z]+'"
rewrite:
    if $W.isupper() or len($W) == 1 or ($W[0].islower() and $W[1:].isupper()):
        print($W.swapcase())
    else:
        print($W)

rule regex_ans_or_regex2_inverted
symptoms: wrong
match:
    ans = re.findall($P1, $W)
    if ans or re.findall($P2, $W):
        print($W)
    else:
        print($W.swapcase())
where: text($P1) == "r'^[A-Z][a-z]+'"
rewrite:
    if $W.isupper() or len($W) == 1 or ($W[0].islower() and $W[1:].isupper()):
        print($W.swapcase())
    else:
        print($W)

rule regex_search_specific_length_bug
symptoms: wrong
match:
    if re.search($P1, $W):
        print($W.swapcase())
    else:
        if re.search($P2, $W):
            print($W.swapcase())
        else:
            print($W)
where: text($P1) == "r'^[a-z][A-Z]$'" and text($P2) == "r'^[A-Z]$'"
rewrite:
    if $W.isupper() or len($W) == 1 or ($W[0].islower() and $W[1:].isupper()):
        print($W.swapcase())
    else:
        print($W)

rule regex_findall_index_error_capitalize
symptoms: wrong, err:IndexError
match:
    ans = re.findall($P, $W)
    if ans[0] == $W:
        print($W.capitalize())
    else:
        print($W)
rewrite:
    if $W.isupper():
        print($W.lower())
    elif len($W) == 1:
        print($W.upper())
    elif $W[0].islower() and $W[1:].isupper():
        print($W.capitalize())
    else:
        print($W)

rule missing_len1_case_helper
symptoms: wrong, err:IndexError
match:
    if $S.isupper() or ($Y.islower() and $X.isupper()):
        return True
    else:
        return False
where: match($X, "$S[1:]") and match($Y, "$S[0]")
rewrite:
    if $S.isupper() or ($Y.islower() and $X.isupper()) or len($S) == 1:
        return True
    else:
        return False

rule missing_single_char_case_general
symptoms: wrong, err:IndexError
match: $X.isupper() or ($X[0].islower() and $Y.isupper())
where: match($Y, "$X[1:]") or match($Y, "$X[1::]")
rewrite: $X.isupper() or ($X[0].islower() and $Y.isupper()) or len($X) == 1

rule missing_single_char_case_general_slice01
symptoms: wrong, err:IndexError
match: $X.isupper() or ($F.islower() and $Y.isupper())
where: match($F, "$X[0:1]") and (match($Y, "$X[1:]") or match($Y, "$X[1::]"))
rewrite: $X.isupper() or ($F.islower() and $Y.isupper()) or len($X) == 1

