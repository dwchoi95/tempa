    if $X.isupper():
        print($X.lower())
    elif $Y.isupper():
        print($X.swapcase())
    else:
        print($X)
where: match($Y, "$X[1:]") or match($Y, "$X[1::]")
rewrite:
    if $X.isupper():
        print($X.lower())
    elif len($X) == 1:
        print($X.upper())
    elif $Y.isupper():
        print($X.swapcase())
    else:
        print($X)

