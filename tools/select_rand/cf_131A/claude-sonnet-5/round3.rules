rule missing_single_char_case_ifelif_and
symptoms: wrong, err:IndexError
match:
    if $X.isupper():
        print($X.lower())
    elif $F.islower() and $Y.isupper():
        print($X.capitalize())
    else:
        print($X)
where: (match($F, "$X[0]") or match($F, "$X[0:1]")) and (match($Y, "$X[1:]") or match($Y, "$X[1::]"))
rewrite:
    if $X.isupper():
        print($X.lower())
    elif len($X) == 1:
        print($X.upper())
    elif $F.islower() and $Y.isupper():
        print($X.capitalize())
    else:
        print($X)

