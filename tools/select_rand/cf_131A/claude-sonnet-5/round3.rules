rule lower_then_capitalize_diffvar
symptoms: wrong
match:
    $V = $E
    $V = $V.lower()
    $W = $V.capitalize()
where: regex($E, "input")
rewrite:
    $V = $E
    if $V.isupper():
        $W = $V.lower()
    elif len($V) == 1:
        $W = $V.upper()
    elif $V[0].islower() and $V[1:].isupper():
        $W = $V.capitalize()
    else:
        $W = $V

rule lower_input_combined_then_manual_capitalize
symptoms: wrong
match:
    $V = input().lower()
    $W = $V[0].upper()+$V[1::]
 |
    $V = input().lower()
    $W = $V[0].upper()+$V[1:]
rewrite:
    $V = input()
    if $V.isupper():
        $W = $V.lower()
    elif len($V) == 1:
        $W = $V.upper()
    elif $V[0].islower() and $V[1:].isupper():
        $W = $V[0].upper()+$V[1:].lower()
    else:
        $W = $V

rule bare_attr_capitalize_in_print
symptoms: wrong
match: print($X.capitalize)
where: kind($X) == "Name"
rewrite: print($X.lower() if $X.isupper() else ($X.upper() if len($X) == 1 else ($X[0].upper()+$X[1:].lower() if $X[0].islower() and $X[1:].isupper() else $X)))

rule unconditional_capitalize_title_name
symptoms: wrong
match: $X.capitalize()
 | $X.title()
where: kind($X) == "Name"
rewrite: ($X.lower() if $X.isupper() else ($X.upper() if len($X) == 1 else ($X[0].upper()+$X[1:].lower() if $X[0].islower() and $X[1:].isupper() else $X)))

rule unconditional_capitalize_title_input_call
symptoms: wrong
match: print(input().capitalize())
 | print(input().title())
rewrite:
    s = input()
    print(s.lower() if s.isupper() else (s.upper() if len(s) == 1 else (s[0].upper()+s[1:].lower() if s[0].islower() and s[1:].isupper() else s)))

rule unconditional_swapcase_name
symptoms: wrong
match: $X.swapcase()
where: kind($X) == "Name"
rewrite: ($X.swapcase() if ($X.isupper() or len($X) == 1 or ($X[0].islower() and $X[1:].isupper())) else $X)

rule unconditional_swapcase_input_call
symptoms: wrong
match: print(input().swapcase())
rewrite:
    s = input()
    print(s.swapcase() if (s.isupper() or len(s) == 1 or (s[0].islower() and s[1:].isupper())) else s)

rule isupper_check_inverted_branches
symptoms: wrong
match:
    if $X.isupper():
        print($X)
    else:
        print($X.capitalize())
rewrite:
    if $X.isupper():
        print($X.lower())
    elif len($X) == 1:
        print($X.upper())
    elif $X[0].islower() and $X[1:].isupper():
        print($X.capitalize())
    else:
        print($X)

