rule regex_or_upper_to_swapcase
symptoms: wrong
match:
    import re

    word = input()
    # ans = re.findall(r'^[A-Z]+[a-z]+', word)
    if re.findall(r'^[a-z][A-Z]+', word) or re.findall(r'^[A-Z]+', word):
        print(word.swapcase())

    else:
        print(word)
rewrite:
    word = input()
    if word.isupper():
        print(word.lower())
    elif word[0].islower() and word[1:].isupper():
        print(word.capitalize())
    elif len(word) == 1 and word.islower():
        print(word.upper())
    else:
        print(word)

