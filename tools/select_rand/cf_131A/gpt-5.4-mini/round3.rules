rule fix_casefold_logic
symptoms: wrong
match:
    s = input()
    if len(s)>=1 or len(s)<= 100:

        if s[0].isupper():
            print(s[0]+s[1:].casefold())
        else:
            if s[1:].isupper():
                print(s[1:].casefold())
            else:
                print(s)
rewrite:
    s = input()
    if s.isupper():
        print(s.lower())
    elif s[0].islower() and s[1:].isupper():
        print(s.capitalize())
    elif len(s) == 1 and s.islower():
        print(s.upper())
    else:
        print(s)

