rule capslock_first_char_upper_rest_lower_loop
symptoms: wrong
match:
    $a = list(str(input()))
    for $i in range(len($a)):
        if $i!=0:
            $a[$i] = $a[$i].lower()
        else:
            $a[$i] = $a[$i].upper()
    for $elt in $a:
        print($elt, end="")
rewrite:
    s = input()
    if s.isupper():
        print(s.lower())
    elif s[0].islower() and s[1:].isupper():
        print(s[0].upper() + s[1:].lower())
    elif len(s) == 1 and s.islower():
        print(s.upper())
    else:
        print(s)

