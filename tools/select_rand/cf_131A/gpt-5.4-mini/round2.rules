rule capslock_input_swapcase_unconditional
symptoms: wrong
match: print(input().swapcase())
rewrite:
    s = input()
    if s.isupper() or (s[0].islower() and s[1:].isupper()) or (len(s) == 1 and s.islower()):
        print(s.swapcase())
    else:
        print(s)

