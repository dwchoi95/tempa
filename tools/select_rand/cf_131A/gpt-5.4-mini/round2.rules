        print($s[0].upper())
rewrite:
    $s = input()
    if len($s) == 1:
        print($s.swapcase())

rule capslock_generic_swapcase_condition
symptoms: wrong
match:
    $s = input()
    if $cond:
        print($s.swapcase())
    else:
        print($s)
where: (match($cond, "$t.isupper()") or match($cond, "$t[1:].isupper()") or match($cond, "$t[1:] == $t[1:].upper()")) and bound($t)
rewrite:
    $s = input()
    if $s.isupper() or ($s[0].islower() and $s[1:].isupper()) or (len($s) == 1 and $s.islower()):
        print($s.swapcase())
    else:
        print($s)

