rule capslock_lower_all_on_all_upper
symptoms: wrong
match:
    s= input()
    k = s.lower()
    print(k)
rewrite:
    s= input()
    if s.isupper():
        print(s.lower())
    else:
        print(s)

rule capslock_if_lower_or_capitalize_builtin_misuse
symptoms: wrong
match:
    s=input()
    if s==s.lower() or s==s.capitalize:
        print(s)
    else:
        print(s.capitalize())
rewrite:
    s=input()
    if s.isupper():
        print(s.lower())
    elif s[0].islower() and s[1:].isupper():
        print(s[0].upper() + s[1:].lower())
    elif len(s) == 1 and s.islower():
        print(s.upper())
    else:
        print(s)

rule capslock_title_on_input
symptoms: wrong
match: print($X.title())
where: kind($X) == "Name" or kind($X) == "Call"
rewrite:
    if $X.isupper():
        print($X.lower())
    elif $X[0].islower() and $X[1:].isupper():
        print($X[0].upper() + $X[1:].lower())
    elif len($X) == 1 and $X.islower():
        print($X.upper())
    else:
        print($X)

