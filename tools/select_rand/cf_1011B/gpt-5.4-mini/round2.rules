rule fix_case_counts_over_types
symptoms: wrong
match:
    def $f($*ps):
        $B:Stmts
where: some($B, "for $i, $x in enumerate($lst):\n    $res += ($d[$x] // $mid)")
rewrite:
    def $f($*ps):
        $B:Stmts

rule fix_sum_over_frequency_values
symptoms: wrong
match:
    for $i in $X:
        $S += $Y
where: regex($Y, r"//\s*$r:Name") and some($X, "$d[$k:Name]") and some($X, "$d.values()")
rewrite:
    for $i in $X:
        $S += $Y

rule fix_binary_search_last_valid_pattern
symptoms: wrong
match:
    while $l <= $r:
        $mid = ($l + $r + 1) // 2
        if not $C:
            $r = $mid - 1
        else:
            $l = $mid + 1
            $an = $mid
where: inside("def $f($*xs): $B:Stmts") and some($B, "print($an)")
rewrite:
    while $l <= $r:
        $mid = ($l + $r + 1) // 2
        if not $C:
            $r = $mid - 1
        else:
            $l = $mid + 1
            $an = $mid

rule fix_print_best_day_variable
symptoms: wrong
match:
    print($an)
where: inside("def $f($*xs): $B:Stmts") and some($B, "$mx:Name = max($*ys)") and some($B, "$an:Name = -1")
rewrite:
    print($mx)

rule fix_zero_day_guard_to_day_check
symptoms: wrong
match:
    if $l == 0:
        if $C1:
            print($r)
        else:
            print(0)
    else:
        if $C2:
            print($l)
        else:
            print($r)
where: some($C1, "$f($r) >= $n") and some($C2, "$f($l) >= $n")
rewrite:
    if $l == 0:
        if $C1:
            print($r)
        else:
            print(0)
    else:
        if $C2:
            print($l)
        else:
            print($r)

rule fix_return_last_checked_candidate
symptoms: wrong
match:
    if $COND:
        print($A)
    else:
        print($B)
where: some($COND, "$f($r) >= $n") and some($COND, "$f($l) >= $n") and text($A) != text($B)
rewrite:
    if $COND:
        print($A)
    else:
        print($B)

rule fix_reverse_sort_before_search
symptoms: wrong
match:
    $L.sort($*xs)[::-1]
where: kind($L) == "Name"
rewrite:
    $L.sort($*xs)

rule fix_compare_day_feasibility
symptoms: wrong
match:
    if $X < $Y:
        $S1
    else:
        $S2
where: some($S1, "$r = $mid - 1") and some($S2, "$l = $mid + 1")
rewrite:
    if $X <= $Y:
        $S1
    else:
        $S2