rule fix_returns_yes_no_string
symptoms: wrong
match:
    def $f($*args):
        $B:Stmts
where:
    some($B, "return is_lucky_digit(str($count))") or some($B, "return is_lucky($count)") or some($B, "return is_lucky_number($count)")
rewrite:
    def $f($*args):
        $B

rule fix_print_input_debug
symptoms: wrong
