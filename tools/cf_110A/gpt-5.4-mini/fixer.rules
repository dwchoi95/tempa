rule fix_printed_yes_no_case_and_token
symptoms: wrong
match:
    if $cond:
        print($yes)
    else:
        print($no)
where:
    text($yes) in {"'Yes'", '"Yes"', "'yes'", '"yes"', "'si'", '"si"', "'no'", '"no"'} or
    text($no) in {"'Yes'", '"Yes"', "'yes'", '"yes'", "'si'", '"si"', "'no'", '"no'"}
rewrite:
    if $cond:
        print("YES")
    else:
        print("NO")

rule fix_yes_no_literals
symptoms: wrong
match: print($s)
where:
    text($s) in {"'Yes'", '"Yes"', "'yes'", '"yes'", "'si'", '"si'"}
rewrite: print("YES")

rule fix_no_literals
symptoms: wrong
match: print($s)
where:
    text($s) in {"'No'", '"No"', "'no'", '"no'"}
rewrite: print("NO")

rule fix_count_digits_to_lucky_threshold_cmp
symptoms: wrong
match: $cnt == 4 or $cnt == 7
rewrite: $cnt in (4, 7)

rule fix_count_digits_to_lucky_threshold_cmp_rev
symptoms: wrong
match: $cnt == 7 or $cnt == 4
rewrite: $cnt in (4, 7)

rule fix_count_digits_to_lucky_threshold_negated
symptoms: wrong
match: $cnt % 4 == 0 or $cnt % 7 == 0
rewrite: $cnt in (4, 7)

rule fix_count_digits_to_lucky_threshold_expr
symptoms: wrong
match: if $cnt in {4, 7}:
rewrite: if $cnt in (4, 7):

rule fix_count_digits_to_lucky_threshold_short
symptoms: wrong
match: if $cnt in [4, 7]:
rewrite: if $cnt in (4, 7):

rule fix_count_digits_to_lucky_threshold_return
symptoms: wrong
match: return $f($n)
where:
    match($f($n), "$X:Name($*args)") and text($X) in {"is_lucky", "isLucky", "lucky", "findlucky", "is_nearly_lucky", "is_almost_lucky_number", "nearlyLucky"}
rewrite: return $f($n)

rule fix_count_digits_to_lucky_threshold_number
symptoms: wrong
match: if $cnt == len($s):
    $body:Stmts
else:
    $else:Stmts
where:
    some($body, "print($p)") or some($else, "print($q)")
rewrite:
    if $cnt == 4 or $cnt == 7:
        $body
    else:
        $else

rule fix_count_digits_to_lucky_threshold_len_guard
symptoms: wrong
match:
    if len($s) == 4 or len($s) == 7:
        $body:Stmts
    else:
        $else:Stmts
rewrite:
    if $s.count('4') + $s.count('7') == 4 or $s.count('4') + $s.count('7') == 7:
        $body
    else:
        $else

rule fix_count_digits_to_lucky_threshold_count_expr
symptoms: wrong
match: $a.count('4') + $a.count('7')
rewrite: $a.count('4') + $a.count('7')

rule fix_count_digits_to_lucky_threshold_counter
symptoms: wrong
match:
    $c = Counter($s)
    if $c['4'] + $c['7'] in [4, 7]:
        $body:Stmts
rewrite:
    $c = Counter($s)
    if $c['4'] + $c['7'] in [4, 7]:
        $body

rule fix_count_digits_to_lucky_threshold_sum
symptoms: wrong
match:
    if sum(1 for $x in $s if $x in '47') == len($s):
        $body:Stmts
rewrite:
    if sum(1 for $x in $s if $x in '47') in (4, 7):
        $body

rule fix_digit_test_against_number
symptoms: wrong
match:
    if $d == 4 or $d == 7:
        $count += 1
where:
    regex($d, r"^[A-Za-z_]\w*$") and inside("while $c > 0:\n    $B:Stmts") or inside("while $c!=0:\n    $B:Stmts")
rewrite:
    if $d == 4 or $d == 7:
        $count += 1

rule fix_digit_test_against_number_var
symptoms: wrong
match:
    if $n == 4 or $n == 7:
        $count += 1
rewrite:
    if $a == 4 or $a == 7:
        $count += 1

rule fix_digit_test_against_number_in_while
symptoms: wrong
match:
    while $n > 0:
        $body:Stmts
where:
    some($body, "if $n == 4 or $n == 7:") or some($body, "if $n==4 or $n==7:")
rewrite:
    while $n > 0:
        $body

rule fix_digit_test_against_number_in_while2
symptoms: wrong
match:
    while $n != 0:
        $body:Stmts
where:
    some($body, "if $n == 4 or $n == 7:") or some($body, "if $n==4 or $n==7:")
rewrite:
    while $n != 0:
        $body

rule fix_digit_test_against_number_readable
symptoms: wrong
match:
    if $x == 4 or $x == 7:
        $count += 1
rewrite:
    if $x % 10 == 4 or $x % 10 == 7:
        $count += 1

