rule fix_count_print_yes_no_tail
symptoms: wrong
match:
    print("YES") if $cond else print("NO")
where:
    some($cond, "count == len($s)") or some($cond, "count == len(str($n))") or some($cond, "count == len($x)")
rewrite:
    print("YES") if $cond and ($count in (4, 7)) else print("NO")

