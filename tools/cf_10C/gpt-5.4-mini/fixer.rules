rule fix_input_to_int_for_digital_root
symptoms: wrong
match: print($X)
where: some($X, "d($Y)") and some($X, "input()")
rewrite:
n = int(input())
q, r = divmod(n, 9)
d = [q] + [q + 1] * r + [q] * (8 - r)
res = 0
for i in range(9):
    for j in range(9):
        res += d[i] * d[j] * d[(i * j) % 9]
for i in range(1, n + 1):
    res -= n // i
print(res)

rule fix_nested_loops_counting_misconception
symptoms: wrong
match:
    $d = 0
    for $i in range(1, $n + 1):
        for $j in range($i, $n + 1):
            $c = $E
            if $K:
                $d = $D
    print($d)
where: some($E, "digr(digr($A) * digr($B))") or some($E, "root($A * $B)") or some($E, "root(i * j)")
rewrite:
n = int(input())
q, r = divmod(n, 9)
d = [q] + [q + 1] * r + [q] * (8 - r)
res = 0
for i in range(9):
    for j in range(9):
        res += d[i] * d[j] * d[(i * j) % 9]
for i in range(1, n + 1):
    res -= n // i
print(res)

rule fix_digit_root_cache_recursion_to_closed_form
symptoms: wrong
