rule fix_product_loop_to_full_square_count
symptoms: wrong
match:
    $s = 0
    $B:Stmts
    print($s)
where: some($B, "for $i in range(1, $n + 1):") and some($B, "for $j in range($i, $n + 1):") and some($B, "if $X not in $Y")
rewrite:
from math import sqrt, floor

n = int(input())

true_products, a = 0, 1

while a ** 2 <= n:
    true_products += n // a - a
    a += 1

true_products *= 2
true_products += floor(sqrt(n))

digit_roots = [n // 9 for _ in range(9)]
for i in range(1, n % 9 + 1):
    digit_roots[i] += 1

digit_root_products = 0

for i in range(9):
    for j in range(9):
        digit_root_products += digit_roots[i] * digit_roots[j] * digit_roots[(i * j) % 9]

print(digit_root_products - true_products)

rule fix_off_by_one_range_start
symptoms: wrong
match: for $i in range($a, $b):
where: text($a) == "1" and text($b) == "n+1" or text($b) == "n + 1"
rewrite: for $i in range(0, $b):

rule fix_less_than_to_less_equal
symptoms: wrong
match: $a < $b
where: not inside("for $_ in range($_, $_): $_")
rewrite: $a <= $b

rule fix_greater_than_to_greater_equal
symptoms: wrong
match: $a > $b
where: not inside("for $_ in range($_, $_): $_")
rewrite: $a >= $b