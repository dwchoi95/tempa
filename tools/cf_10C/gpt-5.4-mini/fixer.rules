    def $f($x):
        $B:Stmts
    print($Y)
where: some($B, "while len(str($x)) != 1:") or some($B, "if($x<=9):") or some($B, "if num<=9:") or some($B, "return root(sm)")
rewrite:
n = int(input())
q, r = divmod(n, 9)
d = [q] + [q + 1] * r + [q] * (8 - r)
res = 0
for i in range(9):
    for j in range(9):
        res += d[i] * d[j] * d[(i * j) % 9]
for i in range(1, n + 1):
    res -= n // i
