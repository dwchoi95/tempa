rule fix_unique_day_name_and_eq
symptoms: wrong
match: def unique_day($p1, $p2):
where: inside("def unique_day($*xs): $B") and (text($p1) != "day" or some($B, "if $L == day:") or some($B, "if day == $R:"))
rewrite: def unique_day(day, $p2):

rule fix_unique_month_name_and_eq
symptoms: wrong
match: def unique_month($p1, $p2):
where: inside("def unique_month($*xs): $B") and (text($p1) != "month" or some($B, "if $L == month:") or some($B, "if month == $R:"))
rewrite: def unique_month(month, $p2):

rule fix_unique_day_count_var
symptoms: wrong
match:
    $count = 0
    for $v in $seq:
        if $L == $R:
            $count += 1
where: inside("def unique_day($*xs): $B:Stmts") and (some($B, "if $L == day:") or some($B, "if day == $R:"))
rewrite:
    $count = 0
    for $v in $seq:
        if $R == $L:
            $count += 1

