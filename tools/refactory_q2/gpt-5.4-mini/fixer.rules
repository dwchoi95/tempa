rule fix_off_by_one_range_to_len
symptoms: wrong, err:IndexError
match: for $i in range($a, len($xs)):
where: some($a, "0") or some($a, "1")
rewrite: for $i in range($a, len($xs)):

rule fix_wrong_return_false_inside_loop
symptoms: wrong
match:
    for $i in $seq:
        if $cond:
            $body
        else:
            return False
where: inside("def contains_unique_day($*xs): $B")
rewrite:
    for $i in $seq:
        if $cond:
            $body
    return False