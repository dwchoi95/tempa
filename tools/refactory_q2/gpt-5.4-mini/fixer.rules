rule fix_contains_unique_day_month_filter
symptoms: wrong
match:
    for $i in $pb:
        if $i[0] == $m:
            $X += ($i,)
where: inside("def contains_unique_day($m, $pb): $B") or inside("def contains_unique_day($m, $pb): $B:Stmts")
rewrite:
    for $i in $pb:
        if $i[0] == $m:
            $X += ($i,)

rule fix_contains_unique_day_day_arg
symptoms: wrong
match: if unique_day($d, $pb):
where: inside("def contains_unique_day($m, $pb): $B")
rewrite: if unique_day($d, $pb):

rule fix_contains_unique_day_return_true_branch
symptoms: wrong
match:
    if $M == $B:
        if unique_day($D, $PB):
            return True
            $REST
where: inside("def contains_unique_day($m, $pb): $BODY:Stmts") and $M == $m
rewrite:
    if $M == $B:
        if unique_day($D, $PB):
            return True

rule fix_contains_unique_day_last_return_false
symptoms: wrong
