rule fix_unique_day_return_non_strict
symptoms: wrong
match:
    if $c > 1:
        return False
    else:
        return True
where: inside("def unique_day($*xs): $B:Stmts") and some($B, "if $L == $R:")
rewrite:
    if $c == 1:
        return True
    else:
        return False

