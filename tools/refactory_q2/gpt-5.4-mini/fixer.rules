rule fix_unique_day_leq
symptoms: wrong
match: return $c <= 1
where: inside("def unique_day($*xs): $B") or inside("def unique_month($*xs): $B")
rewrite: return $c == 1

rule fix_unique_month_leq
symptoms: wrong
match: return $c <= 1
where: inside("def unique_month($*xs): $B") and not inside("def unique_day($*ys): $C")
rewrite: return $c == 1

