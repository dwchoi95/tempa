rule fix_binary_search_upper_bound
symptoms: wrong
match: r = 100
rewrite: r = 100000

rule fix_frequency_division_to_count_possible_days
symptoms: wrong
match: k += $el // s
where: inside("def $f($*xs): $B:Stmts") and some($B, "for $el in $c.values():\n    $X")
rewrite: k += $el // s

rule replace_greedy_frequency_partition_with_simple_max_days
symptoms: wrong
match:
    $foodz = sorted($food.items(), key=operator.itemgetter(1), reverse=True)
    $food = [0]*len($foodz)
    for $i in range(len($foodz)):
        $food[$i] = $foodz[$i][1]
    $b = [0]*len($food)
    $b[0] = $n
    $prev_days = $food[0]//$b[0]
    $min_days = $prev_days
    $min_pos = 0
    for $j in range(1, len($food)):
        $good = False
        $i = 0
        while ($i < $j):
            if $b[$i]-1 >= $b[$i+1]:
                if $b[$i] > 1:
                    $days = min($food[$i]//($b[$i]-1), $food[$j]//($b[$j]+1))
                else:
                    $days = -1
                if $days >= $prev_days:
                    $prev_days = $days
                    if ($min_days > $prev_days):
                       $min_days = $prev_days
                       if $food[$i]//($b[$i]-1) < $food[$j]//($b[$j]+1):
                          $min_pos = $i
                       else:
                          $min_pos = $j
                    if ($min_pos != $i) and ($min_pos != $j):
                       $prev_days = $min_days
                    $b[$i] -= 1
                    $b[$j] += 1
                    $good = True
                    $i -= 1
            $i += 1
        if not($good):
            break
    print($prev_days)
rewrite:
    l = []
    for $k, $v in $myset.items():
        l.append($v)
    l.sort(reverse=True)
    ans = 0
    for i in range(100, 0, -1):
        to = 0
        for j in l:
            to += j // i
        if to >= $n:
            ans = i
            break
    print(ans)

rule fix_counter_input_splitting
symptoms: wrong
match: food=collections.Counter(input().split())
rewrite: food=collections.Counter(map(int, input().split()))

rule fix_map_items_to_int_counter
symptoms: wrong
match:
    food=dict(food)
    $X
rewrite:
    food = dict(food)
    $X

rule comparison_flip_lt_to_le
symptoms: wrong
match: $a < $b
where: parent("if $COND:") or parent("while $COND:")
rewrite: $a <= $b

rule comparison_flip_gt_to_ge
symptoms: wrong
match: $a > $b
where: parent("if $COND:") or parent("while $COND:")
rewrite: $a >= $b

rule off_by_one_range_start
symptoms: wrong
match: range(1, $n)
rewrite: range(1, $n + 1)

rule wrong_return_bool_to_int
symptoms: wrong
match: return True
rewrite: return 1

rule wrong_return_false_to_zero
symptoms: wrong
match: return False
rewrite: return 0