rule fix_contains_unique_day_bad_filter_name_instead_of_month
symptoms: wrong
match:
    for $b:Name in $possible_birthdays:
        if $month == $b[$idx:Int]:
            $tup = $tup + ($b,)
    for $j:Name in range(len($tup)):
        if unique_day($tup[$j][1], $possible_birthdays):
            return True
    return False
where: text($idx) == "0"
rewrite:
    for $b in $possible_birthdays:
        if $b[0] == $month:
            $tup = $tup + ($b,)
    for $j in range(len($tup)):
        if unique_day($tup[$j][1], $possible_birthdays):
            return True
    return False