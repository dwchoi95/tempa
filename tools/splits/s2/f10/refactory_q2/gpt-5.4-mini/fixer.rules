rule fix_unique_day_compare_to_parameter
symptoms: wrong
match:
    def $f($day:Name, $possible_birthdays:Name):
        $*pre
        for $i:Name in range(len($possible_birthdays)):
            if $possible_birthdays[$i][$idx:Int] == $bad:Name:
                $*mid
        $*post
where: text($idx) == "1" and load($day) and text($bad) != text($day)
rewrite:
    def $f($day, $possible_birthdays):
        $*pre
        for $i in range(len($possible_birthdays)):
            if $possible_birthdays[$i][1] == $day:
                $*mid
        $*post

rule fix_unique_month_compare_to_parameter
symptoms: wrong
match:
    def $f($month:Name, $possible_birthdays:Name):
        $*pre
        for $i:Name in range(len($possible_birthdays)):
            if $possible_birthdays[$i][$idx:Int] == $bad:Name:
                $*mid
        $*post
where: text($idx) == "0" and load($month) and text($bad) != text($month)
rewrite:
    def $f($month, $possible_birthdays):
        $*pre
        for $i in range(len($possible_birthdays)):
            if $possible_birthdays[$i][0] == $month:
                $*mid
        $*post

rule fix_counting_return_unique_day_or_month
symptoms: wrong
match:
    if $count $op:Cmp 1:
        return True
    else:
        return False
where: text($op) in {">", ">="}
rewrite:
    return $count == 1

rule fix_counting_return_unique_day_or_month_reversed
symptoms: wrong
match:
    if $count $op:Cmp 1:
        return False
    else:
        return True
where: text($op) in {">", ">="}
rewrite:
    return $count == 1

rule fix_unique_day_month_loop_miscompare
symptoms: wrong
match:
    for $x:Name in $seq:
        if $lhs == $rhs:
            $*body
where: (
    (text($lhs) == text($x) and text($rhs) != text($x)) or
    (text($rhs) == text($x) and text($lhs) != text($x))
)
rewrite:
    for $x in $seq:
        if $rhs == $x:
            $*body

rule fix_contains_unique_day_filter_then_test_current_month_item
symptoms: wrong
match:
    for $b:Name in $possible_birthdays:
        if $b[0] == $month:
            $*body
    for $d:Name in $days:
        if unique_day($d, $possible_birthdays):
            return True
    return False
where: text($days) in {"x", "y", "months", "tup", "value", "birthdays_month", "dates", "days_in_month", "date_list", "month_list", "new_possible_birthdays", "a"}
rewrite:
    for $b in $possible_birthdays:
        if $b[0] == $month:
            $*body
    for $d in $days:
        if unique_day($d, $possible_birthdays):
            return True
    return False

rule fix_contains_unique_day_pass_filtered_bag
symptoms: wrong
match:
    for $b:Name in $possible_birthdays:
        if $b[0] == $month:
            $bag = $bag + ($b,)
    for $d:Name in $bag:
        if unique_day($d[1], $bag):
            return True
    return False
where: load($bag) and text($bag) in {"x", "y", "months", "tup", "value", "birthdays_month", "dates", "days_in_month", "date_list", "month_list", "new_possible_birthdays", "a"}
rewrite:
    for $b in $possible_birthdays:
        if $b[0] == $month:
            $bag = $bag + ($b,)
    for $d in $bag:
        if unique_day($d[1], $possible_birthdays):
            return True
    return False

rule fix_contains_unique_day_use_item_from_filtered_tuple
symptoms: wrong
match:
    for $x:Name in $filtered:
        if unique_day($x[1], $possible_birthdays):
            return True
    return False
where: text($filtered) in {"x", "y", "months", "tup", "value", "birthdays_month", "dates", "days_in_month", "date_list", "month_list", "new_possible_birthdays", "a"}
rewrite:
    for $x in $filtered:
        if unique_day($x[1], $possible_birthdays):
