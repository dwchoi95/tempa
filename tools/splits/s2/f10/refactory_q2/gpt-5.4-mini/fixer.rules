rule fix_contains_unique_day_day_filter_index
symptoms: wrong
match:
    for $i:Name in $possible_birthdays:
        if $month == $i[$idx:Int]:
            $tup = $tup + ($i,)
    for $j:Name in range(len($tup)):
        if unique_day($tup[$j][$dayidx:Int], $possible_birthdays):
            return True
    return False
where: text($idx) == "0" and text($dayidx) == "1"
rewrite:
    for $i in $possible_birthdays:
        if $month == $i[0]:
            $tup = $tup + ($i,)
    for $j in range(len($tup)):
        if unique_day($tup[$j][1], $possible_birthdays):
            return True
    return False

rule fix_contains_unique_day_return_false_only_after_scan
symptoms: wrong
match:
    for $i:Name in $possible_birthdays:
        if $month == $i[0]:
            if unique_day($i[1], $possible_birthdays):
                return True
            else:
                return False
where: inside("def contains_unique_day($*xs): $B:Stmts")
rewrite:
    for $i in $possible_birthdays:
        if $month == $i[0]:
            if unique_day($i[1], $possible_birthdays):
                return True
    return False

rule fix_contains_unique_day_scan_all_possible_birthdays
symptoms: wrong
match:
    for $i:Name in $possible_birthdays:
        if $month == $i[0]:
            if unique_day($i[1], $possible_birthdays):
                return True
    return False
rewrite:
    for $i in $possible_birthdays:
        if $month == $i[0]:
            if unique_day($i[1], $possible_birthdays):
                return True
    return False

rule fix_unique_day_count_greater_than_one
symptoms: wrong
match:
    if $count > 1:
        return False
    else:
        return True
rewrite:
    return $count == 1

rule fix_unique_month_count_greater_than_one
symptoms: wrong
match:
    if $count > 1:
        return False
    else:
        return True
where: inside("def unique_month($*xs): $B:Stmts")
rewrite:
    return $count == 1

rule fix_unique_day_count_various_names
symptoms: wrong
match:
    $counter:Name = 0
    for $b:Name in $possible_birthdays:
        if $day == $b[1]:
            $counter = $counter + 1
    if $counter == 1:
        return True
    else:
        return False
rewrite:
    $counter = 0
    for $b in $possible_birthdays:
        if $b[1] == $day:
            $counter = $counter + 1
    return $counter == 1

rule fix_unique_month_count_various_names
symptoms: wrong
