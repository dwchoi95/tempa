rule capslock_word_uppercase_then_capitalize_to_swapcase
symptoms: wrong
match:
    if(($W[0].islower() and $W[1:].isupper()) or $W.isupper()):
        $W = $W[0].upper() + $W[1:].lower()
    print($W)
rewrite:
    if ($W[1:] == $W[1:].upper()):
        print($W.swapcase())
    else:
        print($W)

rule capslock_loop_print_capitalize_break_to_guarded_swapcase
symptoms: wrong
match:
    for $I in range(len($X)-1):
        if($X.isupper()):
            print($X.capitalize())
            break
        elif($X[0].islower() and $X[$I+1].isupper()):
            print($X.capitalize())
            break
        else:
            print($X)
            break
rewrite:
    if $X[1:] == $X[1:].upper():
        print($X.swapcase())
    else:
        print($X)

rule capslock_helper_correct_to_guarded_swapcase
symptoms: wrong
match:
    def $F($Y):
        if len($Y) == 1:
            $Z = $Y.upper()
        else:
            $Z = $Y[0].upper() + $Y[1:].lower()
        return $Z
    print($F($X))
rewrite:
    if $X[1:] == $X[1:].upper():
        print($X.swapcase())
    else:
        print($X)

rule capslock_first_char_lower_branch_to_swapcase
symptoms: wrong
match:
    $C = $S[0]
    if $C.islower():
        if $S[1:].isupper():
            $R = $S.swapcase()
            print($R)
        else:
            print($S)
    elif $S.isupper():
        $E = $S.swapcase()
        print($E)
    else:
        print($S)
rewrite:
    if $S[1:] == $S[1:].upper():
        print($S.swapcase())
    else:
        print($S)

