rule capslock_only_upper_or_suffix_upper_to_guarded_swapcase
symptoms: wrong
match:
    if $A.isupper() or $B[1:].isupper():
        $X = $B.swapcase()
        print($X)
where: $A == $B
rewrite:
    if $B[1:] == $B[1:].upper():
        print($B.swapcase())
    else:
        print($B)

rule capslock_single_branch_swapcase_to_guarded_swapcase
symptoms: wrong
match:
    if $X.isupper() or $X[1:].isupper():
        $V = $X.swapcase()
        print($V)
where: true
rewrite:
    if $X[1:] == $X[1:].upper():
