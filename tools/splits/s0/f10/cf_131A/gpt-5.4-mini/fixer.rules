rule capslock_isupper_to_lower_or_capitalize
symptoms: wrong
match:
    if $S.isupper() :
        print($S[0] + $S[1:].lower())
    elif ($S[0].islower() and $S[1:].isupper()):
        print($S[0].upper()+ $S[1:].lower())
    else:
        print($S)
rewrite:
    if $S[1:] == $S[1:].upper():
        print($S.swapcase())
    else:
        print($S)