rule capslock_processed_word_assignment_to_guarded_swapcase
symptoms: wrong
match:
    if $W.isupper():
        $P = $W.lower()
    elif $W[1:].isupper():
        $P = $W.capitalize()
    else:
        $P = $W
    print($P)
rewrite:
    if $W[1:] == $W[1:].upper():
        print($W.swapcase())
    else:
        print($W)

