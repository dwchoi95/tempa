    if $w.isupper():
        $pw = $w.lower()
    elif $w[1:].isupper():
        $pw = $w.capitalize()
    else:
        $pw = $w
    print($pw)
rewrite:
    $w = input()
    if $w[1:] == $w[1:].upper():
        print($w.swapcase())
    else:
        print($w)

