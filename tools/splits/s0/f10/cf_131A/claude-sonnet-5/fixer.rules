rule repair9_capitalize_to_condition
symptoms: wrong
match:
    $s = input()
    $res = $s.capitalize()
    print($res)
rewrite:
    $s = input()
    t = $s[1:]
    u = t.upper()
    if t != u:
        print($s)
    else:
        print($s.swapcase())

rule repair1_lower_equality_misconception
symptoms: wrong
match:
    $s = input()
    $a = $s.lower()
    if $a == $s:
        print($s)
    else:
        print($s.swapcase())
rewrite:
    $s = input()
    if $s[1:] == $s[1:].upper():
        print($s.swapcase())
    else:
        print($s)

rule repair2_truthy_method_calls
symptoms: wrong
match:
