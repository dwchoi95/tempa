rule repair7_unconditional_swapcase
symptoms: wrong
match:
    $s = input()
    print($s.swapcase())
rewrite:
    $s = input()
    if $s[1:] == $s[1:].upper():
        print($s.swapcase())
    else:
        print($s)

rule repair10_reassign_then_print
symptoms: wrong
match:
    $w = input()
    if $cond:
        $w = $w[0].upper() + $w[1:].lower()
    print($w)
where: regex($cond, r"isupper")
rewrite:
    $w = input()
    if (len($w) == 1 or $w.isupper() or ($w[0].islower() and $w[1:].isupper())):
        print($w.swapcase())
    else:
        print($w)

rule repair11_loop_based_check
symptoms: wrong
match:
    for $i in range(len($x)-1):
        if($x.isupper()):
            print($x.capitalize())
            break
        elif($x[0].islower() and $x[$i+1].isupper()):
            print($x.capitalize())
            break
        else:
            print($x)
            break
rewrite:
    if $x.isupper():
        print($x.lower())
    elif $x[0].islower() and (not $x[1:] or $x[1:].isupper()):
        print($x.capitalize())
    else:
        print($x)

rule repair12_helper_function_missing_cases
symptoms: wrong
match:
    if len($x) == 1:
        $cw = $x.upper()
    else:
        $cw = $x[0].upper() + $x[1:].lower()
rewrite:
    if len($x) == 1:
        $cw = $x.swapcase()
    elif $x.isupper():
        $cw = $x.lower()
    elif $x[0].islower() and $x[1:].isupper():
        $cw = $x.swapcase()
    else:
        $cw = $x

rule repair8a_first_char_kept_instead_of_lowered
symptoms: wrong
match: $S[0] + $S[1:].lower()
rewrite: $S.lower()

rule repair8b_missing_single_char_guard
symptoms: wrong
match: $S[0].islower() and $S[1:].isupper()
rewrite: len($S) == 1 or ($S[0].islower() and $S[1:].isupper())

rule repair13_empty_rest_isupper_false
symptoms: wrong
match: if $s[1:].isupper():
rewrite: if not $s[1:] or $s[1:].isupper():

rule repair14_counting_lowercase_heuristic
symptoms: wrong
match:
    if $x.isupper()==True:
        print($x.swapcase())
    elif 1==1:
        $n = 0
        for $i in range(len($x)):
            if $x[$i]>='a':
                $n+=1
        if $n==1:
            print($x.swapcase())
    else:
        print($x)
rewrite:
    if $x==$x.upper():
        print($x.lower())
    elif $x[1:]==$x[1:].upper():
        print($x[0].upper()+$x[1:].lower())
    else:
        print($x)

