rule continue_break_threshold_loop
symptoms: wrong
match:
    for $i in range(len($seq)):
        if $x < $seq[$i]:
            continue
        elif $x >= $seq[$i]:
            break
    return $i
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)

rule result_zero_break_pattern
symptoms: wrong
match:
    $r = 0
    for $i in range(len($seq)):
        if $seq[$i] > $x:
            $r = $i
            break
    return $r
rewrite:
    $r = len($seq)
    for $i in range(len($seq)):
        if $seq[$i] >= $x:
            $r = $i
            break
    return $r

rule empty_guard_wrong_return
symptoms: wrong
match:
    if $seq == () or $seq == []:
        return $v
    |
    if $seq == ():
        return $v
where: text($v) != "0"
rewrite:
    if not $seq:
        return 0

rule return_iplus1_after_loop
symptoms: wrong
match:
    for $i, $elem in enumerate($seq):
        $B:Stmts
    return $i + 1
    |
    for $i in range(len($seq)):
        $B:Stmts
    return $i + 1
where: not some($B, "break")
rewrite:
    for $i, $elem in enumerate($seq):
        $B:Stmts
    return len($seq)
    |
    for $i in range(len($seq)):
        $B:Stmts
    return len($seq)

rule maxmin_guard_to_loop
symptoms: wrong
match:
    if max($seq) < $x:
        return len($seq)
    if $x <= min($seq):
        return 0
rewrite:
    for i in range(len($seq)):
        if $x <= $seq[i]:
            return i
    else:
        return len($seq)

rule chain_cond_return_fix
symptoms: wrong
match:
    for $i, $elem in enumerate($seq):
        if $elem < $x < $elem + 1:
            return $i + 1
rewrite:
    for $i, $elem in enumerate($seq):
        if $x <= $elem:
            return $i
    return len($seq)

rule len_without_range_continue_int
symptoms: wrong, err:TypeError
match:
    for $i in len($seq):
        if $seq[$i] < $x:
            continue
        else:
            return int($i - 1)
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    else:
        return len($seq)

rule for_over_len_without_range
symptoms: wrong, err:TypeError
match: for $i in len($seq):
rewrite: for $i in range(len($seq)):

rule seq_reassign_empty_guard
symptoms: wrong
match:
    $seq = []
    $n = len($seq)
    if $seq:
        $B:Stmts
rewrite:
    $n = len($seq)
    $B:Stmts

rule guard_ge_seq_last_to_gt
symptoms: wrong
match:
    if $x >= $seq[-1]:
        return len($seq)
rewrite:
    if $x > $seq[-1]:
        return len($seq)

rule last_elem_le_should_be_lt
symptoms: wrong
match:
    if $seq[-1] <= $x:
        return len($seq)
rewrite:
    if $seq[-1] < $x:
        return len($seq)

rule redundant_guard_after_loop
symptoms: wrong
match:
    for $i in range(len($seq)):
        if $seq[$i] >= $x:
            return $i
    if $seq[len($seq) - 1] < $x:
        return len($seq)
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)

rule guard_ge_max_to_gt
symptoms: wrong
match:
    if $x >= max($seq):
        return len($seq)
rewrite:
    if $x > max($seq):
        return len($seq)

rule merge_lt_eq_branches
symptoms: wrong
match:
    if $x < $seq[$i]:
        return $i
    elif $x == $seq[$i]:
        return $i
    else:
        $C:Stmt
rewrite:
    if $x <= $seq[$i]:
        return $i
    else:
        $C:Stmt

rule tuple_sort_index_misconception
symptoms: wrong
match:
    if type($seq) == tuple:
        $seq = list($seq)
        $seq.append($x)
        sorted($seq)
        $seq.index($x)
rewrite:
    for i in range(len($seq)):
        if $x <= $seq[i]:
            return i
    return len($seq)

rule bracket_search_to_threshold
symptoms: wrong
match:
    for $i in range(len($seq)-1):
        if $x >= $seq[$i] and $x <= $seq[$i+1]:
            break
    return $i
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)

rule guard_continue_loop_to_canonical
symptoms: wrong
match:
    if $x > $seq[len($seq)-1]:
        return len($seq)
    for $i in range(len($seq)):
        if $x > $seq[$i]:
            continue
        return $i
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)

rule counter_overwrite_loop_fix
symptoms: wrong
match:
    $c = 0
    for $i in range(1, len($seq)+1):
        if $x < $seq[$i-1]:
            $c = $i-1
        elif $seq[$i-1]<$x<$seq[$i]:
            $c = $i
        $c = $i
    return $c
rewrite:
    $c = 0
    for $i in range(len($seq)):
        if $x > $seq[$i]:
            $c = $i + 1
        elif $x == $seq[$i]:
            $c = $i
    return $c

rule insert_based_misconception_to_search
symptoms: wrong, err:NameError
match:
    while ($x < $seq[$i] and $i < len($seq)):
        $i += 1
    if $i == len($seq):
        $seq.append($x)
    else:
        $seq.insert($i, $x)
    return $seq
    |
    while ($i < len($seq) and $x < $seq[$i]):
        $i += 1
    if $i == len($seq):
        $seq += ($x,)
    else:
        $seq.insert($i, $x)
    return $seq
rewrite:
    if not $seq:
        return 0
    else:
        for $i in range(len($seq)):
            if $x <= $seq[$i]:
                return $i
            else: continue
        return len($seq)
    |
    if not $seq:
        return 0
    else:
        for $i in range(len($seq)):
            if $x <= $seq[$i]:
                return $i
            else: continue
        return len($seq)

rule count_return_boundary_fix
symptoms: wrong
match: return $c if $seq[-1] > $x else len($seq)
rewrite: return $c if $seq[-1] >= $x else len($seq)

rule unsafe_guard_reorder
symptoms: wrong, err:IndexError
match: if $x <= $seq[0] or not $seq:
rewrite: if not $seq or $x <= $seq[0]:

rule return_len_plus_one
symptoms: wrong
match: return len($seq) + 1
rewrite: return len($seq)