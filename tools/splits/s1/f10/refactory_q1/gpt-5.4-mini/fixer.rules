rule seq_search_fix_skip_full_scan_then_return_i
symptoms: wrong
match:
    for $i in range(len($seq:Name)):
        if $x < $seq[$i]:
            continue
        elif $x >= $seq[$i]:
            break
    return $i
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)

rule seq_search_fix_bad_last_element_return
symptoms: wrong
match:
    if $seq[len($seq) - 1] < $x:
        return len($seq)
rewrite:
    for $i in range(len($seq)):
        if $x <= $seq[$i]:
            return $i
    return len($seq)