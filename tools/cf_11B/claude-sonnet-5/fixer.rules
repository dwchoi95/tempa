rule fix_asymmetric_walk_loop
symptoms: wrong
match:
    while $pos != $x:
        $B:Stmts
    |
    while $x != $pos:
        $B:Stmts
where: some($B, "$n:Name += 1")
rewrite:
    while $pos < abs($x) or ($pos - abs($x)) % 2 != 0:
        $n += 1
        $pos += $n

rule fix_map_input_skeleton
symptoms: wrong
match:
    $x:Name = map(int, input())
    print($x)
rewrite:
    $x = abs(int(input()))
    jumps = 0
    pos = 0
    while pos < $x or (pos - $x) % 2 != 0:
        jumps += 1
        pos += jumps
    print(jumps)

rule strict_lt_should_be_lte
symptoms: wrong
match: $a $o:Cmp $b
where: text($o) in {"<", ">"}
rewrite: $a ${relax[$o]} $b
table relax: {"<": "<=", ">": ">="}